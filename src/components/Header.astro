---
import { getCategories } from '../lib/catalog';
const categories = await getCategories();
---
<header class="site-header">
  <div class="topbar container">
    <button class="menu-toggle" data-nav-toggle aria-label="Abrir menú de categorías" aria-expanded="false" aria-controls="category-nav">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a class="brand" href="/" aria-label="Tulstore inicio"><img src="/images/tulstore-logo.png" alt="Tulstore" /></a>
    <form class="search" action="/buscar" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="q" placeholder="Buscar producto, referencia o color..." aria-label="Buscar productos" />
    </form>
    <button class="cart-open" data-cart-open aria-label="Abrir carrito">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.1 9.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L20 7H6"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg>
      <span class="cart-label">Carrito</span><span class="cart-count" data-cart-count>0</span>
    </button>
  </div>
  <nav class="category-nav" id="category-nav" aria-label="Categorías">
    <div class="container category-scroll"><a href="/productos">Todos</a>{categories.slice(0, 8).map((category) => <a href={`/categoria/${category.slug}`}>{category.name}</a>)}</div>
  </nav>
</header>
<style>
.site-header{position:sticky;top:0;z-index:40;background:var(--navy);color:#fff;box-shadow:0 8px 30px rgba(22,33,62,.18)}
.topbar{height:78px;display:grid;grid-template-columns:auto minmax(240px,1fr) auto;align-items:center;gap:22px}
.menu-toggle{display:none;border:0;background:rgba(255,255,255,.1);color:#fff;border-radius:12px;width:44px;height:44px;place-items:center}
.menu-toggle svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.menu-toggle:hover{background:rgba(255,255,255,.18)}
.brand{height:60px;width:164px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#fff;padding:5px 10px;text-decoration:none}
.brand img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
.search{position:relative}
.search svg{position:absolute;left:15px;top:50%;width:19px;height:19px;transform:translateY(-50%);fill:none;stroke:#667085;stroke-width:2;stroke-linecap:round}
.search input{width:100%;border:0;border-radius:999px;padding:13px 18px 13px 45px;font-size:16px;outline:none;transition:box-shadow .15s ease}
.search input:focus{box-shadow:0 0 0 3px var(--gold)}
.cart-open{border:0;background:var(--coral);color:#fff;border-radius:999px;padding:11px 15px;font-weight:800;display:flex;align-items:center;gap:7px;transition:background .15s ease,transform .15s ease}
.cart-open:hover{background:var(--coral-dark);transform:translateY(-1px)}
.cart-open:active{transform:translateY(0)}
.cart-open svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2}
.cart-count{display:grid;place-items:center;background:white;color:var(--coral-dark);border-radius:999px;min-width:22px;height:22px;padding:0 5px;font-size:.73rem;font-weight:900}
.category-nav{border-top:1px solid rgba(255,255,255,.1)}
.category-scroll{display:flex;gap:8px;overflow-x:auto;padding-top:9px;padding-bottom:9px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.category-scroll::-webkit-scrollbar{display:none}
.category-scroll a{flex:none;color:rgba(255,255,255,.9);text-decoration:none;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:8px 14px;font-size:.82rem;transition:background .15s ease,color .15s ease,border-color .15s ease}
.category-scroll a:hover{background:var(--gold);border-color:var(--gold);color:var(--navy)}
@media(max-width:680px){
  .topbar{height:auto;grid-template-columns:auto 1fr auto;gap:10px;padding-top:9px;padding-bottom:9px}
  .menu-toggle{display:grid}
  .brand{width:118px;height:46px;padding:4px 8px}
  .search{grid-column:1/-1;grid-row:2}
  .cart-label{display:none}
  .cart-open{padding:0;width:44px;height:44px;justify-content:center;position:relative}
  .cart-open .cart-count{position:absolute;top:-4px;right:-4px}
  .category-nav{display:none;border-top:1px solid rgba(255,255,255,.12)}
  .category-nav.open{display:block}
  .category-nav.open .category-scroll{flex-wrap:wrap;overflow:visible}
  .category-scroll a{padding:9px 14px;font-size:.86rem}
}
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('category-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
