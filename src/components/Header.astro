---
import { getCategories } from '../lib/catalog';
import CategoryExplorer from './CategoryExplorer.astro';

const categories = await getCategories();

const pathname = Astro.url.pathname;
const categoryMatch = pathname.match(/^\/categoria\/([^/]+)/);
const catParam = Astro.url.searchParams.get('cat');
const activeSlug = categoryMatch
  ? decodeURIComponent(categoryMatch[1])
  : (catParam ? decodeURIComponent(catParam) : null);
const todosActive = (pathname === '/productos' || pathname === '/productos/') && !activeSlug;
---

<header class="site-header" id="site-header">
  <div class="topbar container">
    <a class="brand" href="/" aria-label="Tulstore inicio">
      <img src="/images/tulstore-logo.png" alt="Tulstore" />
    </a>
    
    <form class="search" action="/buscar" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <input type="search" name="q" placeholder="Buscar en Tulstore..." aria-label="Buscar productos" />
    </form>

    <button class="cart-open" data-cart-open aria-label="Abrir carrito de compras">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="cart-label">Carrito</span>
      <span class="cart-count" data-cart-count>0</span>
    </button>
  </div>

  <nav class="category-nav" id="category-nav" aria-label="Navegación por categorías">
    <div class="container category-nav-inner">
      <!-- Fixed Lead Button: "Todas las categorías" (Always visible on the left) -->
      <div class="cat-lead-fixed">
        <button
          type="button"
          class="cat-lead-btn"
          data-category-modal-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label="Explorar todas las categorías"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="cat-icon">
            <rect x="3" y="3" width="7" height="7" rx="1.5"/>
            <rect x="14" y="3" width="7" height="7" rx="1.5"/>
            <rect x="14" y="14" width="7" height="7" rx="1.5"/>
            <rect x="3" y="14" width="7" height="7" rx="1.5"/>
          </svg>
          <span class="cat-lead-text-desktop">Todas las categorías</span>
          <span class="cat-lead-text-mobile">Categorías</span>
          <span class="cat-lead-badge">{categories.length}</span>
        </button>
      </div>

      <!-- Independently scrollable category chips -->
      <div class="category-scroll" id="header-category-scroll">
        <!-- Quick access chip: Todos -->
        <a
          href="/productos"
          class={todosActive ? 'cat-chip active' : 'cat-chip'}
          aria-current={todosActive ? 'page' : undefined}
          data-cat-slug=""
        >
          Todos
        </a>

        <!-- Quick access categories -->
        {categories.map((category) => (
          <a
            href={`/categoria/${category.slug}`}
            class={activeSlug === category.slug ? 'cat-chip active' : 'cat-chip'}
            aria-current={activeSlug === category.slug ? 'page' : undefined}
            data-cat-slug={category.slug}
          >
            {category.name}
          </a>
        ))}

        <!-- "Más categorías" trigger button -->
        {categories.length > 0 && (
          <button
            type="button"
            class="cat-chip more-cats-btn"
            data-category-modal-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-label="Ver más categorías"
          >
            <span>Más categorías</span>
            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
        )}
      </div>
    </div>
  </nav>

  <!-- Complete Category Explorer Modal (Desktop Mega-Panel & Mobile Bottom-Sheet) -->
  <CategoryExplorer
    categories={categories}
    activeSlug={activeSlug}
    todosActive={todosActive}
  />
</header>

<style>
  /* Header pinned to top so categories and search are accessible from any scroll position */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.15);
  }

  .topbar {
    height: 54px;
    display: grid;
    grid-template-columns: auto minmax(180px, 1fr) auto;
    align-items: center;
    gap: 16px;
  }

  .brand {
    height: 38px;
    width: 126px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: #ffffff;
    padding: 3px 8px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    flex: none;
  }
  .brand img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .search {
    position: relative;
    max-width: 580px;
  }
  .search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .search input {
    width: 100%;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 8px 14px 8px 36px;
    font-size: 0.86rem;
    outline: none;
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.15s ease;
  }
  .search input:focus {
    box-shadow: 0 0 0 2px var(--teal);
  }

  .cart-open {
    border: 0;
    background: var(--teal);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    font-weight: 800;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.25);
    transition: background 0.15s ease, transform 0.15s ease;
    flex: none;
  }
  .cart-open:hover {
    background: var(--teal-dark);
    transform: translateY(-1px);
  }
  .cart-open:active {
    transform: translateY(0);
  }
  .cart-open svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .cart-count {
    display: grid;
    place-items: center;
    background: #ffffff;
    color: var(--teal-dark);
    border-radius: var(--radius-pill);
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 0.72rem;
    font-weight: 900;
  }

  /* Category Navigation Bar */
  .category-nav {
    background: var(--paper);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid var(--line);
  }
  .category-nav-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    padding-top: 5px;
    padding-bottom: 5px;
  }

  /* Fixed Lead Button: "Todas las categorías" */
  .cat-lead-fixed {
    flex: none;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
    padding-right: 8px;
  }
  .cat-lead-fixed::after {
    content: '';
    position: absolute;
    right: 0;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--line);
  }

  /* Independently scrollable category chips */
  .category-scroll {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Primary Lead Button: "Todas las categorías" */
  .cat-lead-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: 7px;
    background: #ffffff;
    border: 1.5px solid var(--teal);
    color: var(--teal-dark);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(13, 148, 136, 0.12);
    transition: all 0.15s ease;
  }
  .cat-lead-btn:hover {
    background: var(--teal-soft);
    border-color: var(--teal-dark);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(13, 148, 136, 0.2);
  }
  .cat-lead-btn:active {
    transform: translateY(0);
  }
  .cat-icon {
    width: 15px;
    height: 15px;
    color: var(--teal);
  }
  .cat-lead-badge {
    background: var(--teal);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    min-width: 18px;
    text-align: center;
  }
  .cat-lead-text-mobile {
    display: none;
  }

  /* Chips */
  .cat-chip {
    flex: none;
    white-space: nowrap;
    color: var(--navy);
    text-decoration: none;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    font-size: 0.78rem;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
  }
  .cat-chip:hover {
    background: var(--teal-soft);
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .cat-chip.active {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(13, 148, 136, 0.25);
  }

  /* "Más categorías" chip button */
  .more-cats-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #ffffff;
    color: var(--ink);
  }
  .chevron-icon {
    width: 12px;
    height: 12px;
    color: var(--ink-soft);
  }

  @media (max-width: 680px) {
    .site-header {
      position: sticky;
      top: 0;
    }
    .topbar {
      height: 48px;
      grid-template-columns: auto 1fr auto;
      gap: 8px;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .brand {
      width: 104px;
      height: 34px;
      padding: 2px 6px;
    }
    .search input {
      font-size: 0.8rem;
      padding: 6px 12px 6px 30px;
    }
    .search svg {
      left: 9px;
      width: 14px;
      height: 14px;
    }
    .cart-label {
      display: none;
    }
    .cart-open {
      padding: 0;
      width: 36px;
      height: 36px;
      justify-content: center;
      position: relative;
    }
    .cart-open .cart-count {
      position: absolute;
      top: -3px;
      right: -3px;
      min-width: 18px;
      height: 18px;
      font-size: 0.68rem;
    }

    .category-nav-inner {
      gap: 6px;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .cat-lead-fixed {
      padding-right: 6px;
    }
    .category-scroll {
      gap: 5px;
      padding-top: 1px;
      padding-bottom: 1px;
    }
    .cat-lead-btn {
      padding: 4px 8px;
      font-size: 0.74rem;
      gap: 5px;
      white-space: nowrap;
    }
    .cat-lead-text-desktop {
      display: none;
    }
    .cat-lead-text-mobile {
      display: inline;
    }
    .cat-chip {
      padding: 4px 10px;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  function centerActiveHeaderCategory(smooth = true) {
    const container = document.querySelector<HTMLElement>('.category-scroll');
    if (!container) return;

    const activeChip = container.querySelector<HTMLElement>('.cat-chip.active');
    if (!activeChip) return;

    const containerRect = container.getBoundingClientRect();
    const chipRect = activeChip.getBoundingClientRect();
    if (containerRect.width === 0 || chipRect.width === 0) return;

    const relativeLeft = chipRect.left - containerRect.left;
    const delta = relativeLeft + (chipRect.width / 2) - (container.clientWidth / 2);
    const targetScrollLeft = container.scrollLeft + delta;
    const maxScrollLeft = container.scrollWidth - container.clientWidth;
    const clamped = Math.max(0, Math.min(targetScrollLeft, maxScrollLeft));

    if (Math.abs(container.scrollLeft - clamped) > 1) {
      container.scrollTo({
        left: clamped,
        behavior: smooth ? 'smooth' : 'auto',
      });
    }
  }

  function initHeaderCategoryScroll() {
    const container = document.querySelector<HTMLElement>('.category-scroll');
    if (!container) return;

    // Start smooth gliding promptly
    window.setTimeout(() => {
      centerActiveHeaderCategory(true);
    }, 20);

    // On clicking any category chip in the bar, animate scroll immediately
    container.querySelectorAll<HTMLElement>('.cat-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const containerRect = container.getBoundingClientRect();
        const chipRect = chip.getBoundingClientRect();
        if (containerRect.width === 0 || chipRect.width === 0) return;
        const relativeLeft = chipRect.left - containerRect.left;
        const delta = relativeLeft + (chipRect.width / 2) - (container.clientWidth / 2);
        const targetScrollLeft = container.scrollLeft + delta;
        const maxScrollLeft = container.scrollWidth - container.clientWidth;
        const clamped = Math.max(0, Math.min(targetScrollLeft, maxScrollLeft));
        container.scrollTo({
          left: clamped,
          behavior: 'smooth',
        });
      });
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        centerActiveHeaderCategory(false);
      }, 100);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderCategoryScroll);
  } else {
    initHeaderCategoryScroll();
  }
  window.addEventListener('load', () => centerActiveHeaderCategory(true));
  window.addEventListener('pageshow', () => centerActiveHeaderCategory(true));
  document.addEventListener('astro:page-load', initHeaderCategoryScroll);
</script>
