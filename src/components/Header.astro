---
import { getCategories } from '../lib/catalog';
const categories = await getCategories();
const mainCategories = categories.slice(0, 5);
const moreCategories = categories.slice(5);

// Presentational active-state derivation (no data change): highlight the chip
// matching the current /categoria/<slug> page, or "Todos" on /productos.
const pathname = Astro.url.pathname;
const categoryMatch = pathname.match(/^\/categoria\/([^/]+)/);
const activeSlug = categoryMatch ? decodeURIComponent(categoryMatch[1]) : null;
const todosActive = pathname === '/productos' || pathname === '/productos/';
---
<header class="site-header">
  <div class="topbar container">
    <a class="brand" href="/" aria-label="Tulstore inicio"><img src="/images/tulstore-logo.png" alt="Tulstore" /></a>
    <form class="search" action="/buscar" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="q" placeholder="Buscar producto, referencia o color..." aria-label="Buscar productos" />
    </form>
    <button class="cart-open" data-cart-open aria-label="Abrir carrito">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.1 9.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L20 7H6"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg>
      <span class="cart-label">Carrito</span><span class="cart-count" data-cart-count>0</span>
    </button>
  </div>
  <nav class="category-nav" id="category-nav" aria-label="Categorías">
    <div class="container category-scroll">
      <span class="cat-lead" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        Categorías
      </span>
      <a href="/productos" class={todosActive ? 'cat-chip active' : 'cat-chip'} aria-current={todosActive ? 'page' : undefined}>Todos</a>
      {mainCategories.map((category) => (
        <a
          href={`/categoria/${category.slug}`}
          class={activeSlug === category.slug ? 'cat-chip active' : 'cat-chip'}
          aria-current={activeSlug === category.slug ? 'page' : undefined}
        >{category.name}</a>
      ))}
      {moreCategories.length > 0 && (
        <div class="more-cats" data-more-cats>
          <button type="button" class="more-toggle" data-more-toggle aria-expanded="false" aria-controls="more-cats-menu">Más categorías ▾</button>
          <div class="more-menu" id="more-cats-menu" data-more-menu hidden>
            {moreCategories.map((category) => (
              <a
                href={`/categoria/${category.slug}`}
                class={activeSlug === category.slug ? 'active' : undefined}
                aria-current={activeSlug === category.slug ? 'page' : undefined}
              >{category.name}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </nav>
</header>
<style>
.site-header{position:relative;z-index:30;background:var(--navy);color:#fff;box-shadow:0 4px 18px rgba(23,37,66,.14)}
.topbar{height:58px;display:grid;grid-template-columns:auto minmax(200px,1fr) auto;align-items:center;gap:16px}
.brand{height:42px;width:138px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#fff;padding:4px 9px;text-decoration:none}
.brand img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
.search{position:relative}
.search svg{position:absolute;left:14px;top:50%;width:18px;height:18px;transform:translateY(-50%);fill:none;stroke:#667085;stroke-width:2;stroke-linecap:round}
.search input{width:100%;border:0;border-radius:999px;padding:10px 16px 10px 42px;font-size:16px;outline:none;transition:box-shadow .15s ease}
.search input:focus{box-shadow:0 0 0 3px var(--teal)}
.cart-open{border:0;background:var(--teal);color:#fff;border-radius:999px;padding:9px 14px;font-weight:800;display:flex;align-items:center;gap:7px;transition:background .15s ease,transform .15s ease}
.cart-open:hover{background:var(--teal-dark);transform:translateY(-1px)}
.cart-open:active{transform:translateY(0)}
.cart-open svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2}
.cart-count{display:grid;place-items:center;background:white;color:var(--teal-dark);border-radius:999px;min-width:21px;height:21px;padding:0 5px;font-size:.72rem;font-weight:900}

/* Compact, light category bar — no sparse navy band, pill chips with a clear active state. */
.category-nav{background:var(--paper);border-top:1px solid rgba(255,255,255,.06)}
/* Desktop: all chips + "Más categorías" fit on one line, no horizontal overflow/scroll. */
.category-scroll{display:flex;align-items:center;flex-wrap:nowrap;gap:7px;padding-top:8px;padding-bottom:8px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.category-scroll::-webkit-scrollbar{display:none}
.cat-lead{flex:none;display:inline-flex;align-items:center;gap:6px;color:var(--ink-soft);font-size:.78rem;font-weight:800;padding-right:4px;margin-right:2px;border-right:1px solid var(--line)}
.cat-lead svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.cat-chip{flex:0 1 auto;min-width:0;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--navy);text-decoration:none;background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:.82rem;font-weight:700;transition:background .15s ease,color .15s ease,border-color .15s ease}
.cat-chip:hover{background:var(--teal-soft);border-color:var(--teal);color:var(--teal-dark)}
.cat-chip.active{background:var(--teal);border-color:var(--teal);color:#fff}
.more-cats{flex:none;position:relative}
.more-toggle{border:1px solid var(--line);background:#fff;color:var(--navy);border-radius:999px;padding:7px 14px;font-size:.82rem;font-weight:800}
.more-toggle:hover{background:var(--teal-soft);border-color:var(--teal);color:var(--teal-dark)}
.more-menu{position:absolute;top:calc(100% + 8px);right:0;z-index:35;background:#fff;border-radius:14px;box-shadow:var(--shadow-lift);padding:8px;min-width:210px;max-height:60vh;overflow-y:auto;display:flex;flex-direction:column;gap:2px}
.more-menu[hidden]{display:none}
.more-menu a{color:var(--ink);text-decoration:none;padding:9px 12px;border-radius:9px;font-size:.86rem}
.more-menu a:hover{background:var(--teal-soft);color:var(--teal-dark)}
.more-menu a.active{background:var(--teal);color:#fff}
@media(max-width:680px){
  .topbar{height:auto;grid-template-columns:auto 1fr auto;gap:9px;padding-top:8px;padding-bottom:8px}
  .brand{width:112px;height:38px;padding:3px 7px}
  .search{grid-column:1/-1;grid-row:2}
  .cart-label{display:none}
  .cart-open{padding:0;width:40px;height:40px;justify-content:center;position:relative}
  .cart-open .cart-count{position:absolute;top:-4px;right:-4px}
  /* Mobile: swipeable horizontal slider — always visible, not hidden behind a menu. */
  .category-scroll{gap:6px;padding-top:7px;padding-bottom:7px;overflow-x:auto}
  .cat-lead{font-size:.72rem;padding-right:3px}
  .cat-lead svg{width:15px;height:15px}
  .cat-chip,.more-toggle{padding:6px 12px;font-size:.78rem}
  /* In the mobile slider chips keep full width (swipe reveals them) — no ellipsis cap. */
  .cat-chip{flex:none;max-width:none;overflow:visible;text-overflow:clip}
  /* On mobile the dropdown opens as a left-anchored sheet so it never overflows the viewport. */
  .more-menu{position:fixed;left:10px;right:10px;top:auto;min-width:0;max-height:50vh}
}
</style>
<script>
  // "Más categorías" dropdown (keyboard + touch accessible, vanilla).
  const moreWrap = document.querySelector<HTMLElement>('[data-more-cats]');
  const moreToggle = moreWrap?.querySelector<HTMLButtonElement>('[data-more-toggle]');
  const moreMenu = moreWrap?.querySelector<HTMLElement>('[data-more-menu]');
  const setMore = (open: boolean) => {
    if (!moreMenu || !moreToggle) return;
    moreMenu.hidden = !open;
    moreToggle.setAttribute('aria-expanded', String(open));
  };
  moreToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = moreMenu ? Boolean(moreMenu.hidden) : true;
    setMore(isHidden);
  });
  document.addEventListener('click', (e) => {
    if (moreWrap && e.target instanceof Node && !moreWrap.contains(e.target)) setMore(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMore(false);
  });
  moreMenu?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) setMore(false);
  });
</script>
