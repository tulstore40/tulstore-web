---
import { getCategories } from '../lib/catalog';
const categories = await getCategories();
const mainCategories = categories.slice(0, 5);
const moreCategories = categories.slice(5);

const pathname = Astro.url.pathname;
const categoryMatch = pathname.match(/^\/categoria\/([^/]+)/);
const activeSlug = categoryMatch ? decodeURIComponent(categoryMatch[1]) : null;
const todosActive = pathname === '/productos' || pathname === '/productos/';
---

<header class="site-header" id="site-header">
  <div class="topbar container">
    <a class="brand" href="/" aria-label="Tulstore inicio">
      <img src="/images/tulstore-logo.png" alt="Tulstore" />
    </a>
    
    <form class="search" action="/buscar" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <input type="search" name="q" placeholder="Buscar en Tulstore..." aria-label="Buscar productos" />
    </form>

    <button class="cart-open" data-cart-open aria-label="Abrir carrito de compras">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="cart-label">Carrito</span>
      <span class="cart-count" data-cart-count>0</span>
    </button>
  </div>

  <nav class="category-nav" id="category-nav" aria-label="Navegación por categorías">
    <div class="container category-scroll">
      <button type="button" class="cat-lead-btn" data-mobile-cats-open aria-label="Ver todas las categorías">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="cat-icon">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span>Categorías</span>
      </button>

      <a href="/productos" class={todosActive ? 'cat-chip active' : 'cat-chip'} aria-current={todosActive ? 'page' : undefined}>
        Todos
      </a>

      {mainCategories.map((category) => (
        <a
          href={`/categoria/${category.slug}`}
          class={activeSlug === category.slug ? 'cat-chip active' : 'cat-chip'}
          aria-current={activeSlug === category.slug ? 'page' : undefined}
        >
          {category.name}
        </a>
      ))}

      {moreCategories.length > 0 && (
        <div class="more-cats-wrapper" data-more-cats-wrapper>
          <button
            type="button"
            class="cat-chip more-toggle"
            data-more-cats-toggle
            aria-expanded="false"
            aria-controls="desktop-cats-menu"
          >
            <span>Más categorías</span>
            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <!-- Desktop Dropdown -->
          <div class="desktop-cats-dropdown" id="desktop-cats-menu" data-desktop-cats-menu>
            <div class="dropdown-arrow"></div>
            <div class="dropdown-list">
              {moreCategories.map((category) => (
                <a
                  href={`/categoria/${category.slug}`}
                  class={activeSlug === category.slug ? 'dropdown-item active' : 'dropdown-item'}
                  aria-current={activeSlug === category.slug ? 'page' : undefined}
                >
                  <span class="item-name">{category.name}</span>
                  <span class="item-count">{category.count}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </nav>

  <!-- Mobile Bottom-Sheet Modal for Categories -->
  <div class="mobile-cats-overlay" data-mobile-cats-overlay></div>
  <div class="mobile-cats-drawer" data-mobile-cats-drawer role="dialog" aria-modal="true" aria-label="Todas las categorías">
    <div class="drawer-header">
      <div class="drawer-header-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="drawer-cat-icon">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <strong>Todas las categorías</strong>
      </div>
      <button type="button" class="drawer-close-btn" data-mobile-cats-close aria-label="Cerrar menú de categorías">×</button>
    </div>
    <div class="drawer-body">
      <a href="/productos" class={todosActive ? 'drawer-item active' : 'drawer-item'}>
        <span class="item-name">Todos los productos</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="item-chevron"><path d="m9 18 6-6-6-6"/></svg>
      </a>
      {categories.map((c) => (
        <a href={`/categoria/${c.slug}`} class={activeSlug === c.slug ? 'drawer-item active' : 'drawer-item'}>
          <span class="item-name">{c.name}</span>
          <span class="item-count-badge">{c.count}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="item-chevron"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  /* Header pinned to top so categories and search are accessible from any scroll position */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.15);
  }

  .topbar {
    height: 54px;
    display: grid;
    grid-template-columns: auto minmax(180px, 1fr) auto;
    align-items: center;
    gap: 16px;
  }

  .brand {
    height: 38px;
    width: 126px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: #ffffff;
    padding: 3px 8px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    flex: none;
  }
  .brand img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .search {
    position: relative;
    max-width: 580px;
  }
  .search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .search input {
    width: 100%;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 8px 14px 8px 36px;
    font-size: 0.86rem;
    outline: none;
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.15s ease;
  }
  .search input:focus {
    box-shadow: 0 0 0 2px var(--teal);
  }

  .cart-open {
    border: 0;
    background: var(--teal);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    font-weight: 800;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.25);
    transition: background 0.15s ease, transform 0.15s ease;
    flex: none;
  }
  .cart-open:hover {
    background: var(--teal-dark);
    transform: translateY(-1px);
  }
  .cart-open:active {
    transform: translateY(0);
  }
  .cart-open svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .cart-count {
    display: grid;
    place-items: center;
    background: #ffffff;
    color: var(--teal-dark);
    border-radius: var(--radius-pill);
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 0.72rem;
    font-weight: 900;
  }

  /* Category Navigation Bar */
  .category-nav {
    background: var(--paper);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid var(--line);
  }
  .category-scroll {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  .cat-lead-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 0;
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 5px 8px 5px 2px;
    margin-right: 2px;
    border-right: 1px solid var(--line);
    cursor: pointer;
  }
  .cat-lead-btn:hover {
    color: var(--teal-dark);
  }
  .cat-icon {
    width: 15px;
    height: 15px;
  }

  .cat-chip {
    flex: none;
    white-space: nowrap;
    color: var(--navy);
    text-decoration: none;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    font-size: 0.78rem;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
  }
  .cat-chip:hover {
    background: var(--teal-soft);
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .cat-chip.active {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(13, 148, 136, 0.25);
  }

  .more-cats-wrapper {
    flex: none;
    position: relative;
  }
  .more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .chevron-icon {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }
  .more-toggle[aria-expanded="true"] .chevron-icon {
    transform: rotate(180deg);
  }

  /* Desktop Dropdown: Pure positioned popup, NO background overlay to block clicks */
  .desktop-cats-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 100;
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.16);
    padding: 6px;
    min-width: 220px;
    max-height: 60vh;
    overflow-y: auto;
  }
  .desktop-cats-dropdown.open {
    display: block;
  }
  .dropdown-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dropdown-item {
    color: var(--ink);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-item:hover {
    background: var(--teal-soft);
    color: var(--teal-dark);
  }
  .dropdown-item.active {
    background: var(--teal);
    color: #ffffff;
  }
  .item-count {
    font-size: 0.72rem;
    background: var(--paper);
    color: var(--ink-soft);
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    font-weight: 700;
  }
  .dropdown-item.active .item-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Mobile Drawer & Overlay: Hidden on Desktop */
  .mobile-cats-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }
  .mobile-cats-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-cats-drawer {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: #ffffff;
    border-radius: 20px 20px 0 0;
    max-height: 80vh;
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.28);
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-direction: column;
  }
  .mobile-cats-drawer.open {
    transform: translateY(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  .drawer-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--navy);
  }
  .drawer-cat-icon {
    width: 20px;
    height: 20px;
    color: var(--teal);
  }
  .drawer-header strong {
    font-size: 1rem;
    font-weight: 800;
  }
  .drawer-close-btn {
    border: 0;
    background: none;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0 4px;
  }

  .drawer-body {
    padding: 12px 14px 24px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .drawer-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 650;
    background: var(--paper);
    border: 1px solid transparent;
    transition: background 0.15s ease;
  }
  .drawer-item:active, .drawer-item:hover {
    background: var(--teal-soft);
    color: var(--teal-dark);
  }
  .drawer-item.active {
    background: var(--teal);
    color: #ffffff;
  }
  .item-count-badge {
    margin-left: auto;
    margin-right: 8px;
    font-size: 0.72rem;
    background: #ffffff;
    color: var(--ink-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-weight: 800;
  }
  .drawer-item.active .item-count-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }
  .item-chevron {
    width: 16px;
    height: 16px;
    opacity: 0.5;
    flex: none;
  }

  @media (max-width: 680px) {
    .site-header {
      position: sticky;
      top: 0;
    }
    .topbar {
      height: 48px;
      grid-template-columns: auto 1fr auto;
      gap: 8px;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .brand {
      width: 104px;
      height: 34px;
      padding: 2px 6px;
    }
    .search input {
      font-size: 0.8rem;
      padding: 6px 12px 6px 30px;
    }
    .search svg {
      left: 9px;
      width: 14px;
      height: 14px;
    }
    .cart-label {
      display: none;
    }
    .cart-open {
      padding: 0;
      width: 36px;
      height: 36px;
      justify-content: center;
      position: relative;
    }
    .cart-open .cart-count {
      position: absolute;
      top: -3px;
      right: -3px;
      min-width: 18px;
      height: 18px;
      font-size: 0.68rem;
    }

    .category-scroll {
      gap: 5px;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .cat-lead-btn {
      font-size: 0.72rem;
      padding: 4px 6px 4px 0;
    }
    .cat-chip {
      padding: 4px 10px;
      font-size: 0.75rem;
    }

    /* On mobile, disable the desktop hover/dropdown and use mobile drawer instead */
    .desktop-cats-dropdown {
      display: none !important;
    }
    .mobile-cats-overlay {
      display: block;
    }
    .mobile-cats-drawer {
      display: flex;
    }
  }
</style>

<script>
  // Robust Category Menu Controller for both Desktop Dropdown and Mobile Bottom-Sheet
  function initHeaderCategories() {
    const isMobile = () => window.innerWidth <= 680;

    // Desktop elements
    const moreWrapper = document.querySelector<HTMLElement>('[data-more-cats-wrapper]');
    const desktopToggle = moreWrapper?.querySelector<HTMLButtonElement>('[data-more-cats-toggle]');
    const desktopMenu = moreWrapper?.querySelector<HTMLElement>('[data-desktop-cats-menu]');

    // Mobile elements
    const mobileOpenBtns = document.querySelectorAll<HTMLElement>('[data-mobile-cats-open]');
    const mobileDrawer = document.querySelector<HTMLElement>('[data-mobile-cats-drawer]');
    const mobileOverlay = document.querySelector<HTMLElement>('[data-mobile-cats-overlay]');
    const mobileCloseBtn = document.querySelector<HTMLButtonElement>('[data-mobile-cats-close]');

    // Toggle Desktop Menu
    const setDesktopOpen = (open: boolean) => {
      if (!desktopMenu || !desktopToggle) return;
      if (open) {
        desktopMenu.classList.add('open');
        desktopToggle.setAttribute('aria-expanded', 'true');
      } else {
        desktopMenu.classList.remove('open');
        desktopToggle.setAttribute('aria-expanded', 'false');
      }
    };

    // Toggle Mobile Drawer
    const setMobileOpen = (open: boolean) => {
      if (!mobileDrawer || !mobileOverlay) return;
      if (open) {
        mobileOverlay.classList.add('open');
        mobileDrawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      } else {
        mobileDrawer.classList.remove('open');
        mobileOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    };

    // Toggle click on desktop button:
    // If on mobile, open mobile drawer; if on desktop, toggle desktop dropdown!
    desktopToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isMobile()) {
        setMobileOpen(true);
      } else {
        const isOpen = desktopMenu?.classList.contains('open') ?? false;
        setDesktopOpen(!isOpen);
      }
    });

    // Mobile open triggers (e.g. clicking "Categorías" button)
    mobileOpenBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        setMobileOpen(true);
      });
    });

    // Mobile close triggers
    mobileCloseBtn?.addEventListener('click', () => setMobileOpen(false));
    mobileOverlay?.addEventListener('click', () => setMobileOpen(false));

    // Global click listener to close desktop dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (moreWrapper && e.target instanceof Node && !moreWrapper.contains(e.target)) {
        setDesktopOpen(false);
      }
    });

    // ESC key closes both
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setDesktopOpen(false);
        setMobileOpen(false);
      }
    });
  }

  // Run on load and after client navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderCategories);
  } else {
    initHeaderCategories();
  }
</script>
