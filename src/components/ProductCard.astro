---
import type { Product } from '../lib/catalog';
import { formatCOP } from '../lib/format';
const { product } = Astro.props as { product: Product };
---
<article class="product-card">
  <a class="image-wrap" href={`/producto/${product.slug}`} aria-label={`Ver ${product.nombre}`}>
    <img src={product.imagen} alt={product.nombre} loading="lazy" width="480" height="480" />
  </a>
  <div class="body">
    <div class="category">{product.categoria}</div>
    <a class="name" href={`/producto/${product.slug}`}>{product.nombre}</a>
    <div class="ref">REF: {product.referencia}</div>
    <div class="price">{formatCOP(product.precio)}</div>
    <div class="actions">
      <button class="btn btn-primary add" data-add-cart data-product={JSON.stringify({id: product.tulstoreId, slug: product.slug, name: product.nombre, price: product.precio, image: product.imagen, ref: product.referencia})}>Agregar</button>
      <a class="wa" href={`https://wa.me/573182022859?text=${encodeURIComponent(`Hola Tulstore, me interesa ${product.nombre} (${product.referencia}) por ${formatCOP(product.precio)}.`)}`} target="_blank" rel="noopener" aria-label={`Comprar ${product.nombre} por WhatsApp`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>
  </div>
</article>
<style>
.product-card{background:var(--card);border-radius:var(--radius-card);box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;min-width:0;transition:transform .18s ease,box-shadow .18s ease}.product-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift)}
.image-wrap{position:relative;aspect-ratio:1/1;background:white;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--line);overflow:hidden}.image-wrap img{width:100%;height:100%;object-fit:contain;padding:14px;transition:transform .2s ease}.product-card:hover .image-wrap img{transform:scale(1.025)}.flag{position:absolute;z-index:2;left:10px;top:10px;background:var(--gold);color:var(--navy);font-weight:800;border-radius:999px;padding:5px 8px;font-size:.7rem}
.body{padding:13px 14px 14px;display:flex;flex-direction:column;flex:1}.category{font-size:.72rem;color:var(--ink-soft);font-weight:700;margin-bottom:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.name{font-weight:800;line-height:1.3;text-decoration:none;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em}.name:hover{color:var(--navy)}.ref{font-size:.7rem;color:var(--ink-soft);margin:7px 0}.price{font-size:1.18rem;font-weight:850;color:var(--coral-dark);margin-top:auto;margin-bottom:11px}.actions{display:flex;gap:7px}.add{flex:1;padding:11px 11px;min-height:44px}.wa{width:46px;min-height:44px;display:grid;place-items:center;background:var(--whatsapp);color:#fff;text-decoration:none;border-radius:14px;transition:background .15s ease,transform .15s ease}.wa svg{width:22px;height:22px}.wa:hover{background:var(--whatsapp-dark);transform:translateY(-1px)}
@media(max-width:680px){.body{padding:11px}.category{font-size:.66rem}.name{font-size:.86rem}.price{font-size:1.02rem}.actions{gap:6px}.add{padding:10px 8px;font-size:.82rem;min-height:44px}.wa{width:44px;min-height:44px}.wa svg{width:20px;height:20px}.image-wrap img{padding:10px}}
</style>
