---
import type { Product } from '../lib/catalog';
import { formatCOP } from '../lib/format';
const { product } = Astro.props as { product: Product };
const subtitle = [product.referencia, product.color].filter(Boolean).join(' · ');
---
<article class="product-card">
  <a class="image-wrap" href={`/producto/${product.slug}`} aria-label={`Ver detalle de ${product.nombre}`}>
    <img
      src={product.imagen}
      alt={product.nombre}
      loading="lazy"
      decoding="async"
      width="440"
      height="440"
      onerror="this.onerror=null;this.src='/images/tulstore-logo.png';this.style.objectFit='contain';"
    />
  </a>
  <div class="card-content">
    <div class="card-meta">
      {subtitle && <span class="ref-color">{subtitle}</span>}
      <a class="product-title" href={`/producto/${product.slug}`} title={product.nombre}>
        {product.nombre}
      </a>
    </div>
    <div class="card-footer">
      <div class="price-wrap">
        <span class="price-val">{formatCOP(product.precio)}</span>
      </div>
      <div class="action-buttons">
        <a
          class="btn-icon-wa"
          href={`https://wa.me/573182022859?text=${encodeURIComponent(`Hola Tulstore, me interesa ${product.nombre} (${product.referencia}) por ${formatCOP(product.precio)}.`)}`}
          target="_blank"
          rel="noopener"
          aria-label={`Consultar ${product.nombre} por WhatsApp`}
          title="Consultar por WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z"/>
          </svg>
        </a>
        <button
          type="button"
          class="btn-add-cart"
          data-add-cart
          data-product={JSON.stringify({
            id: product.tulstoreId,
            slug: product.slug,
            name: product.nombre,
            price: product.precio,
            image: product.imagen,
            ref: product.referencia
          })}
          aria-label={`Agregar ${product.nombre} al carrito`}
        >
          <svg class="cart-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="btn-text">Agregar</span>
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }
  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--line-strong);
  }

  .image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #f1f5f9;
    overflow: hidden;
    padding: 12px;
    text-decoration: none;
  }
  .image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .product-card:hover .image-wrap img {
    transform: scale(1.04);
  }

  .card-content {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    background: #ffffff;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .ref-color {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-title {
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.3;
    text-decoration: none;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
    transition: color 0.15s ease;
  }
  .product-title:hover {
    color: var(--teal-dark);
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .price-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .price-val {
    font-size: 1.15rem;
    font-weight: 850;
    color: var(--navy);
    letter-spacing: -0.02em;
  }

  .action-buttons {
    display: flex;
    gap: 7px;
    align-items: center;
  }

  .btn-add-cart {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 38px;
    height: 38px;
    padding: 0 12px;
    background: var(--teal);
    color: #ffffff;
    border: 0;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 750;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(13, 148, 136, 0.2);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-add-cart:hover {
    background: var(--teal-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);
  }
  .btn-add-cart:active {
    transform: translateY(0);
  }
  .btn-add-cart.added {
    background: #059669 !important;
    color: #ffffff !important;
  }
  .btn-add-cart .cart-icon {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .btn-add-cart .btn-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .btn-icon-wa {
    flex: none;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--whatsapp-soft);
    color: var(--whatsapp-dark);
    border: 1px solid rgba(37, 211, 102, 0.25);
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .btn-icon-wa:hover {
    background: var(--whatsapp);
    color: #ffffff;
    border-color: var(--whatsapp);
    transform: translateY(-1px);
  }
  .btn-icon-wa:active {
    transform: translateY(0);
  }
  .btn-icon-wa svg {
    width: 19px;
    height: 19px;
  }

  @media (max-width: 480px) {
    .card-content { padding: 10px 11px 12px; gap: 6px; }
    .product-title { font-size: 0.82rem; }
    .price-val { font-size: 1.05rem; }
    .btn-add-cart, .btn-icon-wa { min-height: 36px; height: 36px; }
    .btn-icon-wa { width: 36px; }
    .btn-add-cart { font-size: 0.8rem; padding: 0 8px; }
    .image-wrap { padding: 8px; }
  }
</style>

