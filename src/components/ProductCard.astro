---
import type { Product } from '../lib/catalog';
import { formatCOP } from '../lib/format';
const { product } = Astro.props as { product: Product };
---
<article class="product-card">
  <a class="image-wrap" href={`/producto/${product.slug}`} aria-label={`Ver ${product.nombre}`}>
    <img src={product.imagen} alt={product.nombre} loading="lazy" width="480" height="480" />
  </a>
  <div class="body">
    <a class="name" href={`/producto/${product.slug}`}>{product.nombre}</a>
    <div class="foot">
      <div class="price">{formatCOP(product.precio)}</div>
      <div class="actions">
        <a class="wa" href={`https://wa.me/573182022859?text=${encodeURIComponent(`Hola Tulstore, me interesa ${product.nombre} (${product.referencia}) por ${formatCOP(product.precio)}.`)}`} target="_blank" rel="noopener" aria-label={`Comprar ${product.nombre} por WhatsApp`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z" fill="currentColor" stroke="none"/></svg>
        </a>
        <button class="add" data-add-cart data-product={JSON.stringify({id: product.tulstoreId, slug: product.slug, name: product.nombre, price: product.precio, image: product.imagen, ref: product.referencia})} aria-label={`Agregar ${product.nombre} al carrito`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 9.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L20 7H6"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg>
          <span>Agregar</span>
        </button>
      </div>
    </div>
  </div>
</article>
<style>
.product-card{background:var(--card);border-radius:var(--radius-card);box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;min-width:0;transition:transform .18s ease,box-shadow .18s ease}.product-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift)}
.image-wrap{position:relative;aspect-ratio:1/1;background:white;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--line);overflow:hidden}.image-wrap img{width:100%;height:100%;object-fit:contain;padding:10px;transition:transform .2s ease}.product-card:hover .image-wrap img{transform:scale(1.03)}
.body{padding:8px 9px 9px;display:flex;flex-direction:column;flex:1;gap:6px}
.name{font-weight:750;font-size:.82rem;line-height:1.25;text-decoration:none;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.5em}.name:hover{color:var(--teal-dark)}
.foot{margin-top:auto;display:flex;flex-direction:column;gap:7px}
.price{font-size:.98rem;font-weight:850;color:var(--navy)}
.actions{display:flex;gap:6px}
.add,.wa{min-height:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:11px;text-decoration:none;transition:background .15s ease,transform .15s ease}
/* "Agregar" button takes the width; icon + legible compact label. WA stays a fixed-width icon button beside it. */
.add{flex:1 1 auto;min-width:0;gap:5px;background:var(--teal);color:#fff;font-weight:800;font-size:.76rem;padding:0 8px}
.add:hover{background:var(--teal-dark);transform:translateY(-1px)}
.add svg{flex:none;width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.add span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wa{flex:none;width:36px;background:var(--whatsapp);color:#fff}.wa:hover{background:var(--whatsapp-dark);transform:translateY(-1px)}.wa svg{width:19px;height:19px}
@media(min-width:560px){.body{padding:11px 12px 12px;gap:7px}.name{font-size:.9rem;min-height:2.4em}.price{font-size:1.08rem}.add,.wa{min-height:42px;height:42px}.wa{width:42px}.add{font-size:.9rem;gap:7px;padding:0 12px}.add svg{width:19px;height:19px}.image-wrap img{padding:12px}}
@media(min-width:900px){.price{font-size:1.14rem}}
</style>
