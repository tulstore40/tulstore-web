---
import ProductCard from './ProductCard.astro';
import type { Product, Category } from '../lib/catalog';
import type { CatalogConfig } from '../lib/siteConfig';

interface Props {
  products: Product[];
  config: CatalogConfig;
  categoryFilter?: boolean;
  categories?: Category[];
}

const { products, config, categoryFilter = true, categories = [] } = Astro.props as Props;

// Serialized config consumed by the boot script
const dataConfig = JSON.stringify({
  pageSize: config.pageSize || 24,
  defaultSort: config.defaultSort || 'relevancia',
  categoryFilter,
  priceFilter: config.priceFilter,
});

// Render the initial 24 products in SSR for instant SEO and FCP without bloat
const INITIAL_SSR_COUNT = 24;
const initialProducts = products.slice(0, INITIAL_SSR_COUNT);

// Tarjeta "molde": se renderiza UNA vez con el mismo componente que las tarjetas SSR y el
// controlador la clona y rellena. Así las tarjetas dinámicas llevan los mismos atributos
// data-astro-cid-* (estilos encapsulados) y nunca divergen de ProductCard.astro.
const templateProduct: Product = {
  tulstoreId: '',
  referencia: '',
  nombre: '',
  slug: '',
  color: '',
  precio: 0,
  categoria: '',
  categoriaSlug: '',
  descripcion: '',
  imagen: '',
  estado: 'ACTIVO',
};

// Ultra-compact JSON payload containing the entire catalog data (~120KB for 1,000 products instead of 6MB of HTML)
const compactCatalogJson = products.map((p, index) => ({
  id: p.tulstoreId,
  ref: p.referencia || '',
  name: p.nombre,
  slug: p.slug,
  color: p.color || '',
  price: p.precio,
  cat: p.categoria,
  catSlug: p.categoriaSlug,
  img: p.imagen,
  idx: index,
}));
---
<section class="catalog-root" data-catalog-root data-config={dataConfig}>
  <script type="application/json" id="catalog-products-json" set:html={JSON.stringify(compactCatalogJson)}></script>

  <!-- Sticky Quick Bar -->
  <div class="sticky-bar">
    <div class="container bar-inner">
      <div class="bar-search">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" data-catalog-search placeholder="Buscar en catálogo..." aria-label="Buscar en el catálogo" />
      </div>
      <button type="button" class="bar-btn" data-filter-open aria-expanded="false" aria-controls="filter-sheet">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span>Filtros</span>
        <span class="filter-count" data-filter-count hidden></span>
      </button>
      <button type="button" class="bar-btn cart" data-cart-open aria-label="Abrir carrito">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-count" data-cart-count>0</span>
      </button>
    </div>
  </div>

  <!-- In-place Category Chips Bar -->
  {categoryFilter && categories.length > 0 && (
    <div class="chips-row">
      <div class="container chips-scroll">
        <button type="button" class="chip active" data-filter-chip="" aria-pressed="true">Todas</button>
        {categories.map((c) => (
          <button type="button" class="chip" data-filter-chip={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>
    </div>
  )}

  <div class="container catalog-body">
    <div class="catalog-count-row">
      <span class="catalog-count" data-catalog-count>{products.length} productos</span>
    </div>

    <!-- The Product Grid: Only holds active rendered cards, avoiding 1,000 DOM nodes! -->
    <div class="product-grid" data-catalog-grid>
      {initialProducts.map((product) => (
        <div class="grid-item" data-id={product.tulstoreId}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <template data-card-template>
      <div class="grid-item" data-id="">
        <ProductCard product={templateProduct} />
      </div>
    </template>

    <div class="empty-state" data-catalog-empty hidden>

      <div class="empty-icon">🔍</div>
      <strong>No encontramos productos</strong>
      <p>Intenta con otra palabra clave o restablece los filtros aplicados.</p>
    </div>

    <div class="see-more-wrap" data-see-more-wrap>
      <button type="button" class="btn btn-primary see-more-btn" data-see-more>
        <span>Ver más</span>
      </button>
    </div>
  </div>

  <!-- Filter Bottom-Sheet Modal -->
  <div class="filter-overlay" data-filter-overlay></div>
  <div
    class="filter-sheet"
    id="filter-sheet"
    data-filter-sheet
    role="dialog"
    aria-modal="true"
    aria-labelledby="filter-sheet-title"
    aria-hidden="true"
  >
    <div class="sheet-head">
      <strong id="filter-sheet-title">Filtros de búsqueda</strong>
      <button type="button" class="sheet-close" data-filter-close aria-label="Cerrar filtros">×</button>
    </div>
    <div class="sheet-body">
      {categoryFilter && categories.length > 0 && (
        <label class="field">
          <span>Categoría</span>
          <select data-filter-cat>
            <option value="">Todas las categorías ({products.length})</option>
            {categories.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
          </select>
        </label>
      )}
      {config.priceFilter && (
        <div class="field-row">
          <label class="field">
            <span>Precio mínimo ($)</span>
            <input type="number" inputmode="numeric" min="0" data-filter-min placeholder="0" />
          </label>
          <label class="field">
            <span>Precio máximo ($)</span>
            <input type="number" inputmode="numeric" min="0" data-filter-max placeholder="Sin límite" />
          </label>
        </div>
      )}
      <label class="field">
        <span>Ordenar por</span>
        <select data-filter-sort>
          {config.sortOptions.map((o) => <option value={o.key}>{o.label}</option>)}
        </select>
      </label>
    </div>
    <div class="sheet-foot">
      <button type="button" class="btn sheet-clear" data-filter-clear>Limpiar</button>
      <button type="button" class="btn btn-primary sheet-apply" data-filter-apply>Aplicar filtros</button>
    </div>
  </div>
</section>

<script>
  import { initCatalog } from '../scripts/catalog-controller';
  import type { CatalogControllerConfig } from '../scripts/catalog-controller';

  const DEFAULTS: CatalogControllerConfig = {
    pageSize: 24,
    defaultSort: 'relevancia',
    categoryFilter: true,
    priceFilter: true,
  };

  const root = document.querySelector<HTMLElement>('[data-catalog-root]');
  if (root) {
    let parsedConfig: CatalogControllerConfig = DEFAULTS;
    const raw = root.dataset.config;
    if (raw) {
      try {
        const c = JSON.parse(raw);
        parsedConfig = {
          pageSize: typeof c.pageSize === 'number' && c.pageSize > 0 ? c.pageSize : DEFAULTS.pageSize,
          defaultSort: c.defaultSort || DEFAULTS.defaultSort,
          categoryFilter: typeof c.categoryFilter === 'boolean' ? c.categoryFilter : DEFAULTS.categoryFilter,
          priceFilter: typeof c.priceFilter === 'boolean' ? c.priceFilter : DEFAULTS.priceFilter,
        };
      } catch (e) {
        console.error('Error parsing catalog config:', e);
      }
    }
    initCatalog(root, parsedConfig);
  }
</script>

<style>
  .catalog-root {
    position: relative;
    padding-bottom: 48px;
  }

  .sticky-bar {
    position: sticky;
    top: 54px;
    z-index: 35;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    padding: 8px 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    transition: top 0.15s ease;
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bar-search {
    flex: 1;
    position: relative;
    min-width: 0;
  }
  .bar-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 2.2;
    pointer-events: none;
  }
  .bar-search input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 7px 12px 7px 34px;
    font-size: 0.84rem;
    outline: none;
    background: var(--paper);
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .bar-search input:focus {
    border-color: var(--teal);
    background: #ffffff;
  }

  .bar-btn {
    flex: none;
    border: 1px solid var(--line);
    background: #ffffff;
    color: var(--navy);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 750;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .bar-btn:hover {
    background: var(--teal-soft);
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .bar-btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .filter-count {
    background: var(--teal);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 1px 6px;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .bar-btn.cart {
    background: var(--navy);
    color: #ffffff;
    border-color: var(--navy);
    padding: 6px 10px;
  }
  .bar-btn.cart:hover {
    background: var(--teal-dark);
    border-color: var(--teal-dark);
  }
  .bar-btn.cart .cart-count {
    background: #ffffff;
    color: var(--navy);
    border-radius: var(--radius-pill);
    padding: 1px 5px;
    font-size: 0.68rem;
    font-weight: 900;
  }

  /* In-place Category Chips */
  .chips-row {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 6px 0;
  }
  .chips-scroll {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .chips-scroll::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex: none;
    border: 1px solid var(--line);
    background: #ffffff;
    color: var(--ink);
    border-radius: var(--radius-pill);
    padding: 4px 11px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .chip:hover {
    background: var(--teal-soft);
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .chip.active {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(13, 148, 136, 0.25);
  }

  .catalog-body {
    padding-top: 14px;
  }
  .catalog-count-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 10px;
  }
  .catalog-count {
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .empty-state {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 36px 20px;
    text-align: center;
    margin: 24px 0;
  }
  .empty-icon {
    font-size: 2rem;
    margin-bottom: 8px;
  }
  .empty-state strong {
    display: block;
    font-size: 1.1rem;
    color: var(--navy);
    margin-bottom: 4px;
  }
  .empty-state p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    margin: 0;
  }

  .see-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 24px;
    padding-bottom: 12px;
  }
  .see-more-btn {
    padding: 10px 28px;
    font-size: 0.88rem;
    font-weight: 800;
  }

  /* Filter Bottom-Sheet Modal */
  .filter-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }
  .filter-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: #ffffff;
    border-radius: 20px 20px 0 0;
    max-height: 85vh;
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.28);
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }
  .filter-sheet.open {
    transform: translateY(0);
  }
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  .sheet-head strong {
    font-size: 1.05rem;
    color: var(--navy);
  }
  .sheet-close {
    border: 0;
    background: none;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .sheet-body {
    padding: 18px 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field span {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .field select, .field input {
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 10px 14px;
    font-size: 0.88rem;
    background: var(--paper);
    color: var(--ink);
    outline: none;
  }
  .field select:focus, .field input:focus {
    border-color: var(--teal);
    background: #ffffff;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .sheet-foot {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 12px;
    padding: 14px 20px 24px;
    border-top: 1px solid var(--line);
    background: #ffffff;
    flex: none;
  }
  .sheet-clear {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .sheet-clear:hover {
    background: #e2e8f0;
  }
  .sheet-apply {
    background: var(--navy);
    color: #ffffff;
  }
  .sheet-apply:hover {
    background: var(--teal);
  }

  @media (max-width: 680px) {
    .sticky-bar {
      top: 48px;
      padding: 6px 0;
    }
    .bar-inner {
      gap: 6px;
    }
    .bar-btn {
      padding: 5px 10px;
      font-size: 0.76rem;
    }
    .bar-btn span:not(.filter-count):not(.cart-count) {
      display: inline;
    }
    .chips-row {
      padding: 4px 0;
    }
    .catalog-body {
      padding-top: 8px;
    }
    .catalog-count-row {
      margin-bottom: 6px;
    }
  }
</style>
