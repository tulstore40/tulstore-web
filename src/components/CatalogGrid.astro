---
import ProductCard from './ProductCard.astro';
import type { Product, Category } from '../lib/catalog';
import type { CatalogConfig } from '../lib/siteConfig';

interface Props {
  products: Product[];
  config: CatalogConfig;
  categoryFilter?: boolean;
  categories?: Category[];
}

const { products, config, categoryFilter = true, categories = [] } = Astro.props as Props;

// Serialized config consumed by the boot script
const dataConfig = JSON.stringify({
  pageSize: config.pageSize,
  defaultSort: config.defaultSort,
  categoryFilter,
  priceFilter: config.priceFilter,
});
---
<section class="catalog-root" data-catalog-root data-config={dataConfig}>
  <div class="sticky-bar">
    <div class="container bar-inner">
      <div class="bar-search">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" data-catalog-search placeholder="Buscar en el catálogo..." aria-label="Buscar en el catálogo" />
      </div>
      <button type="button" class="bar-btn" data-filter-open aria-expanded="false" aria-controls="filter-sheet">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span>Filtros</span>
        <span class="filter-count" data-filter-count hidden></span>
      </button>
      <button type="button" class="bar-btn cart" data-cart-open aria-label="Abrir carrito">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-count" data-cart-count>0</span>
      </button>
    </div>
  </div>

  {categoryFilter && categories.length > 0 && (
    <div class="chips-row">
      <div class="container chips-scroll">
        {categories.map((c) => (
          <button type="button" class="chip" data-filter-chip={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>
    </div>
  )}

  <div class="container catalog-body">
    <div class="catalog-count-row">
      <span class="catalog-count" data-catalog-count>{products.length} productos</span>
    </div>
    <div class="product-grid">
      {products.map((product) => (
        <div
          class="grid-item"
          data-cat={product.categoriaSlug}
          data-price={product.precio}
          data-name={product.nombre}
          data-haystack={`${product.nombre} ${product.referencia} ${product.color} ${product.categoria}`.toLocaleLowerCase('es')}
          hidden
        >
          <ProductCard product={product} />
        </div>
      ))}
    </div>
    <div class="empty-state" data-catalog-empty hidden>
      No encontramos productos que coincidan con los filtros seleccionados.
    </div>
    <div class="see-more-wrap" hidden>
      <button type="button" class="btn btn-primary see-more-btn" data-see-more hidden>
        <span>Ver más</span>
      </button>
    </div>
  </div>

  <!-- Filter bottom-sheet -->
  <div class="filter-overlay" data-filter-overlay></div>
  <div
    class="filter-sheet"
    id="filter-sheet"
    data-filter-sheet
    role="dialog"
    aria-modal="true"
    aria-labelledby="filter-sheet-title"
    aria-hidden="true"
  >
    <div class="sheet-head">
      <strong id="filter-sheet-title">Filtros</strong>
      <button type="button" class="sheet-close" data-filter-close aria-label="Cerrar filtros">×</button>
    </div>
    <div class="sheet-body">
      {categoryFilter && categories.length > 0 && (
        <label class="field">
          <span>Categoría</span>
          <select data-filter-cat>
            <option value="">Todas las categorías</option>
            {categories.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
          </select>
        </label>
      )}
      {config.priceFilter && (
        <div class="field-row">
          <label class="field">
            <span>Precio mínimo</span>
            <input type="number" inputmode="numeric" min="0" data-filter-min placeholder="0" />
          </label>
          <label class="field">
            <span>Precio máximo</span>
            <input type="number" inputmode="numeric" min="0" data-filter-max placeholder="Sin límite" />
          </label>
        </div>
      )}
      <label class="field">
        <span>Ordenar por</span>
        <select data-filter-sort>
          {config.sortOptions.map((o) => <option value={o.key}>{o.label}</option>)}
        </select>
      </label>
    </div>
    <div class="sheet-foot">
      <button type="button" class="btn sheet-clear" data-filter-clear>Limpiar</button>
      <button type="button" class="btn btn-primary sheet-apply" data-filter-apply>Aplicar filtros</button>
    </div>
  </div>
</section>

<script>
  import { initCatalog, isSortKey } from '../scripts/catalog-controller';
  import type { CatalogControllerConfig } from '../scripts/catalog-controller';
  import type { SortKey } from '../lib/siteConfig';

  const DEFAULTS: CatalogControllerConfig = {
    pageSize: 24,
    defaultSort: 'relevancia',
    categoryFilter: true,
    priceFilter: true,
  };

  function validateConfig(raw: unknown): CatalogControllerConfig {
    if (typeof raw !== 'object' || raw === null) return DEFAULTS;
    const obj = raw as Record<string, unknown>;

    const pageSizeNum = Number(obj.pageSize);
    const pageSize = Number.isNaN(pageSizeNum) || pageSizeNum <= 0 ? 24 : Math.floor(pageSizeNum);

    const defaultSort: SortKey = isSortKey(obj.defaultSort) ? obj.defaultSort : 'relevancia';

    const categoryFilter = typeof obj.categoryFilter === 'boolean' ? obj.categoryFilter : true;
    const priceFilter = typeof obj.priceFilter === 'boolean' ? obj.priceFilter : true;

    return { pageSize, defaultSort, categoryFilter, priceFilter };
  }

  const root = document.querySelector<HTMLElement>('[data-catalog-root]');
  if (root) {
    let parsed: unknown = {};
    try {
      parsed = JSON.parse(root.dataset.config ?? '{}');
    } catch {
      parsed = {};
    }
    initCatalog(root, validateConfig(parsed));
  }
</script>

<style>
  .sticky-bar { display: none; }
  .bar-inner { display: flex; align-items: center; gap: 8px; padding: 10px 0; }
  .bar-search { position: relative; flex: 1 1 auto; min-width: 0; }
  .bar-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 17px;
    height: 17px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .bar-search input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 10px 14px 10px 36px;
    font-size: 0.9rem;
    outline: none;
    background: #ffffff;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.06);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .bar-search input:focus {
    box-shadow: 0 0 0 3px var(--teal-soft);
    border-color: var(--teal);
  }
  .bar-btn {
    flex: none;
    position: relative;
    border: 1px solid var(--line);
    background: #ffffff;
    color: var(--navy);
    border-radius: var(--radius-pill);
    height: 40px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 750;
    font-size: 0.82rem;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
    cursor: pointer;
  }
  .bar-btn svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .bar-btn.cart {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    width: 40px;
    padding: 0;
    justify-content: center;
  }
  .bar-btn .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    place-items: center;
    background: #ffffff;
    color: var(--teal-dark);
    border-radius: var(--radius-pill);
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 0.68rem;
    font-weight: 900;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .filter-count {
    display: grid;
    place-items: center;
    background: var(--coral);
    color: #ffffff;
    border-radius: var(--radius-pill);
    min-width: 19px;
    height: 19px;
    padding: 0 4px;
    font-size: 0.66rem;
    font-weight: 900;
  }

  .chips-row { margin-bottom: 8px; }
  .chips-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 8px 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .chips-scroll::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    border: 1px solid var(--line);
    background: #ffffff;
    border-radius: var(--radius-pill);
    padding: 7px 15px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--navy);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .chip:hover {
    background: var(--teal-soft);
    border-color: var(--teal);
    color: var(--teal-dark);
    transform: translateY(-1px);
  }
  .chip.active {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(13, 148, 136, 0.25);
  }

  .catalog-body { padding-top: 14px; }
  .catalog-count-row { margin-bottom: 14px; }
  .catalog-count { color: var(--ink-soft); font-size: 0.86rem; font-weight: 600; }
  
  .see-more-wrap {
    display: flex;
    justify-content: center;
    margin: 36px 0 18px;
  }
  .see-more-btn {
    min-width: 220px;
    padding: 13px 26px;
    font-size: 0.94rem;
    font-weight: 800;
    border-radius: var(--radius-pill);
    background: var(--navy);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.16);
    cursor: pointer;
    transition: transform 0.18s ease, background 0.15s ease, box-shadow 0.18s ease;
  }
  .see-more-btn:hover {
    transform: translateY(-2px);
    background: var(--navy-surface);
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.24);
  }

  .filter-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(3px);
    z-index: 70;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .filter-overlay.open { opacity: 1; pointer-events: auto; }

  .filter-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 75;
    background: #ffffff;
    border-radius: 24px 24px 0 0;
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 -14px 40px rgba(0, 0, 0, 0.2);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .filter-sheet.open { transform: translateY(0); }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
  }
  .sheet-head strong { font-size: 1.15rem; color: var(--navy); font-weight: 800; }
  .sheet-close {
    border: 0;
    background: none;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .sheet-body {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow-y: auto;
  }
  .field { display: flex; flex-direction: column; gap: 7px; }
  .field > span { font-size: 0.84rem; font-weight: 750; color: var(--navy); }
  .field select, .field input {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.95rem;
    background: #ffffff;
    outline: none;
    min-height: 46px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field select:focus, .field input:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px var(--teal-soft);
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sheet-foot {
    display: flex;
    gap: 12px;
    padding: 16px 22px;
    border-top: 1px solid var(--line);
  }
  .sheet-clear {
    flex: 1;
    background: var(--paper);
    color: var(--navy);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .sheet-apply { flex: 1.4; border-radius: var(--radius-pill); }

  @media (max-width: 899px) {
    .sticky-bar {
      display: block;
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(248, 250, 252, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
      padding-top: env(safe-area-inset-top);
    }
  }
</style>

