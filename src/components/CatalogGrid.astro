---
import ProductCard from './ProductCard.astro';
import type { Product, Category } from '../lib/catalog';
import type { CatalogConfig } from '../lib/siteConfig';

interface Props {
  products: Product[];
  config: CatalogConfig;
  categoryFilter?: boolean;
  categories?: Category[];
}

const { products, config, categoryFilter = true, categories = [] } = Astro.props as Props;

// Serialized config consumed by the boot script (DECISION 1).
const dataConfig = JSON.stringify({
  pageSize: config.pageSize,
  defaultSort: config.defaultSort,
  categoryFilter,
  priceFilter: config.priceFilter,
});
---
<section class="catalog-root" data-catalog-root data-config={dataConfig}>
  <div class="sticky-bar">
    <div class="container bar-inner">
      <div class="bar-search">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" data-catalog-search placeholder="Buscar en el catálogo..." aria-label="Buscar en el catálogo" />
      </div>
      <button type="button" class="bar-btn" data-filter-open aria-expanded="false" aria-controls="filter-sheet">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span>Filtros</span>
        <span class="filter-count" data-filter-count hidden></span>
      </button>
      <button type="button" class="bar-btn cart" data-cart-open aria-label="Abrir carrito">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.1 9.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L20 7H6"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg>
        <span class="cart-count" data-cart-count>0</span>
      </button>
    </div>
  </div>

  {categoryFilter && categories.length > 0 && (
    <div class="chips-row">
      <div class="container chips-scroll">
        {categories.map((c) => (
          <button type="button" class="chip" data-filter-chip={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>
    </div>
  )}

  <div class="container catalog-body">
    <div class="catalog-count" data-catalog-count>{products.length} productos</div>
    <div class="product-grid">
      {products.map((product) => (
        <div
          class="grid-item"
          data-cat={product.categoriaSlug}
          data-price={product.precio}
          data-name={product.nombre}
          data-haystack={`${product.nombre} ${product.referencia} ${product.color} ${product.categoria}`.toLocaleLowerCase('es')}
          hidden
        >
          <ProductCard product={product} />
        </div>
      ))}
    </div>
    <div class="empty-state" data-catalog-empty hidden>No encontramos productos con esos filtros.</div>
    <div class="see-more-wrap">
      <button type="button" class="btn btn-primary see-more" data-see-more hidden>Ver más</button>
    </div>
  </div>

  <!-- Filter bottom-sheet -->
  <div class="filter-overlay" data-filter-overlay></div>
  <div
    class="filter-sheet"
    id="filter-sheet"
    data-filter-sheet
    role="dialog"
    aria-modal="true"
    aria-labelledby="filter-sheet-title"
    aria-hidden="true"
  >
    <div class="sheet-head">
      <strong id="filter-sheet-title">Filtros</strong>
      <button type="button" class="sheet-close" data-filter-close aria-label="Cerrar filtros">×</button>
    </div>
    <div class="sheet-body">
      {categoryFilter && categories.length > 0 && (
        <label class="field">
          <span>Categoría</span>
          <select data-filter-cat>
            <option value="">Todas</option>
            {categories.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
          </select>
        </label>
      )}
      {config.priceFilter && (
        <div class="field-row">
          <label class="field">
            <span>Precio mínimo</span>
            <input type="number" inputmode="numeric" min="0" data-filter-min placeholder="0" />
          </label>
          <label class="field">
            <span>Precio máximo</span>
            <input type="number" inputmode="numeric" min="0" data-filter-max placeholder="Sin límite" />
          </label>
        </div>
      )}
      <label class="field">
        <span>Ordenar por</span>
        <select data-filter-sort>
          {config.sortOptions.map((o) => <option value={o.key}>{o.label}</option>)}
        </select>
      </label>
    </div>
    <div class="sheet-foot">
      <button type="button" class="btn sheet-clear" data-filter-clear>Limpiar</button>
      <button type="button" class="btn btn-primary sheet-apply" data-filter-apply>Aplicar</button>
    </div>
  </div>
</section>

<script>
  import { initCatalog, isSortKey } from '../scripts/catalog-controller';
  import type { CatalogControllerConfig } from '../scripts/catalog-controller';
  import type { SortKey } from '../lib/siteConfig';

  const DEFAULTS: CatalogControllerConfig = {
    pageSize: 32,
    defaultSort: 'relevancia',
    categoryFilter: true,
    priceFilter: true,
  };

  function validateConfig(raw: unknown): CatalogControllerConfig {
    if (typeof raw !== 'object' || raw === null) return DEFAULTS;
    const obj = raw as Record<string, unknown>;

    const pageSizeNum = Number(obj.pageSize);
    const pageSize = Number.isNaN(pageSizeNum) || pageSizeNum <= 0 ? 32 : Math.floor(pageSizeNum);

    const defaultSort: SortKey = isSortKey(obj.defaultSort) ? obj.defaultSort : 'relevancia';

    const categoryFilter = typeof obj.categoryFilter === 'boolean' ? obj.categoryFilter : true;
    const priceFilter = typeof obj.priceFilter === 'boolean' ? obj.priceFilter : true;

    return { pageSize, defaultSort, categoryFilter, priceFilter };
  }

  const root = document.querySelector<HTMLElement>('[data-catalog-root]');
  if (root) {
    let parsed: unknown = {};
    try {
      parsed = JSON.parse(root.dataset.config ?? '{}');
    } catch {
      parsed = {};
    }
    initCatalog(root, validateConfig(parsed));
  }
</script>

<style>
  .sticky-bar{display:none}
  .bar-inner{display:flex;align-items:center;gap:8px;padding:8px 0}
  .bar-search{position:relative;flex:1 1 auto;min-width:0}
  .bar-search svg{position:absolute;left:12px;top:50%;width:17px;height:17px;transform:translateY(-50%);fill:none;stroke:#667085;stroke-width:2;stroke-linecap:round}
  .bar-search input{width:100%;border:0;border-radius:999px;padding:11px 14px 11px 36px;font-size:16px;outline:none;background:#fff;box-shadow:var(--shadow)}
  .bar-search input:focus{box-shadow:0 0 0 3px var(--teal)}
  .bar-btn{flex:none;position:relative;border:0;background:#fff;color:var(--navy);border-radius:999px;height:42px;padding:0 13px;display:inline-flex;align-items:center;gap:6px;font-weight:800;font-size:.82rem;box-shadow:var(--shadow)}
  .bar-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
  .bar-btn.cart{background:var(--teal);color:#fff;width:42px;padding:0;justify-content:center}
  .bar-btn .cart-count{position:absolute;top:-4px;right:-4px;display:grid;place-items:center;background:#fff;color:var(--teal-dark);border-radius:999px;min-width:20px;height:20px;padding:0 5px;font-size:.68rem;font-weight:900}
  .filter-count{display:grid;place-items:center;background:var(--coral);color:#fff;border-radius:999px;min-width:19px;height:19px;padding:0 4px;font-size:.66rem;font-weight:900}

  .chips-row{margin-bottom:4px}
  .chips-scroll{display:flex;gap:8px;overflow-x:auto;padding:8px 14px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .chips-scroll::-webkit-scrollbar{display:none}
  .chip{flex:none;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 13px;font-size:.8rem;font-weight:700;color:var(--navy);transition:background .15s ease,border-color .15s ease,color .15s ease}
  .chip:hover{background:var(--teal-soft);border-color:var(--teal)}
  .chip.active{background:var(--teal);border-color:var(--teal);color:#fff}

  .catalog-body{padding-top:12px}
  .catalog-count{color:var(--ink-soft);font-size:.84rem;margin-bottom:12px}
  .see-more-wrap{display:flex;justify-content:center;margin-top:22px}
  .see-more{min-width:200px}

  .filter-overlay{position:fixed;inset:0;background:rgba(22,33,62,.5);z-index:64;opacity:0;pointer-events:none;transition:opacity .2s ease}
  .filter-overlay.open{opacity:1;pointer-events:auto}
  .filter-sheet{position:fixed;left:0;right:0;bottom:0;z-index:66;background:#fff;border-radius:20px 20px 0 0;transform:translateY(100%);transition:transform .25s ease;box-shadow:0 -14px 40px rgba(0,0,0,.2);max-height:85vh;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom)}
  .filter-sheet.open{transform:none}
  .sheet-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--line)}
  .sheet-head strong{font-size:1.1rem;color:var(--navy)}
  .sheet-close{border:0;background:none;font-size:1.9rem;line-height:1;color:var(--ink-soft)}
  .sheet-body{padding:18px 20px;display:flex;flex-direction:column;gap:16px;overflow-y:auto}
  .field{display:flex;flex-direction:column;gap:6px}
  .field>span{font-size:.82rem;font-weight:700;color:var(--navy)}
  .field select,.field input{border:1px solid var(--line);border-radius:12px;padding:12px 12px;font-size:16px;background:#fff;outline:none;min-height:44px}
  .field select:focus,.field input:focus{box-shadow:0 0 0 3px var(--teal)}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .sheet-foot{display:flex;gap:10px;padding:16px 20px;border-top:1px solid var(--line)}
  .sheet-clear{flex:1;background:var(--paper);color:var(--navy);border:1px solid var(--line)}
  .sheet-apply{flex:1}

  @media(max-width:899px){
    .sticky-bar{display:block;position:sticky;top:0;z-index:50;background:var(--paper);padding-top:env(safe-area-inset-top)}
  }
</style>
