---
import type { HeroConfig } from '../../lib/siteConfig';
const { data } = Astro.props as { data: HeroConfig };
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{data.eyebrow}</span>
      <h1>{data.title}</h1>
      <p>{data.subtitle}</p>
      <div class="hero-actions">
        <a class="btn btn-coral" href={data.primaryCta.href}>{data.primaryCta.label}</a>
        <a class="btn secondary" href={data.secondaryCta.href}>{data.secondaryCta.label}</a>
      </div>
      <div class="trust">{data.trust.map((t) => <span>{t}</span>)}</div>
    </div>
    {data.showBrandPanel && (
      <div class="hero-visual">
        <div class="brand-panel">
          <img src="/images/tulstore-logo.png" alt="Tulstore" />
        </div>
      </div>
    )}
  </div>
</section>
<style>
.hero{background:linear-gradient(135deg,var(--navy) 0%,#1f3a63 58%,var(--teal-dark) 118%);color:white;overflow:hidden}
.hero-grid{min-height:380px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:38px;padding-top:40px;padding-bottom:40px}
.eyebrow{font-size:.74rem;letter-spacing:.13em;font-weight:900;color:var(--gold)}
.hero h1{font-size:clamp(2.2rem,4.4vw,3.9rem);line-height:1;letter-spacing:-.05em;margin:12px 0 16px;max-width:720px}
.hero p{font-size:1.02rem;line-height:1.6;color:rgba(255,255,255,.82);max-width:620px}
.hero-actions{display:flex;gap:10px;margin-top:20px}
.secondary{background:rgba(255,255,255,.1);color:white;border:1px solid rgba(255,255,255,.22)}
.trust{display:flex;gap:18px;flex-wrap:wrap;color:rgba(255,255,255,.7);font-size:.8rem;margin-top:22px}
.hero-visual{display:flex;justify-content:end}
.brand-panel{background:white;border-radius:24px;box-shadow:0 24px 56px rgba(0,0,0,.2);padding:24px;transform:rotate(1.5deg);width:min(100%,400px)}
.brand-panel img{display:block;width:100%;height:220px;object-fit:contain}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;min-height:auto}.hero-visual{justify-content:center}.brand-panel{width:min(100%,340px)}.brand-panel img{height:170px}}
@media(max-width:680px){.hero-grid{padding-top:26px;padding-bottom:28px;gap:22px}.hero h1{font-size:2rem;margin:8px 0 12px}.hero p{font-size:.92rem}.hero-actions{flex-direction:column;align-items:stretch}.trust{gap:7px 14px;font-size:.74rem;margin-top:16px}.brand-panel{display:none}}
</style>
