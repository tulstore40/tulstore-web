---
import type { HeroConfig } from '../../lib/siteConfig';
const { data } = Astro.props as { data: HeroConfig };
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{data.eyebrow}</span>
      <h1>{data.title}</h1>
      <p>{data.subtitle}</p>
      <div class="hero-actions">
        <a class="btn btn-teal hero-cta-btn" href={data.primaryCta.href}>
          <span>{data.primaryCta.label}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="btn secondary" href={data.secondaryCta.href}>{data.secondaryCta.label}</a>
      </div>
      <div class="trust">
        {data.trust.map((t) => <span>• {t}</span>)}
      </div>
    </div>
    {data.showBrandPanel && (
      <div class="hero-visual">
        <div class="brand-panel">
          <img src="/images/tulstore-logo.png" alt="Tulstore" />
          <div class="brand-badge-pill">Tienda Oficial Colombia</div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 55%, #0F766E 130%);
    color: #ffffff;
    overflow: hidden;
    position: relative;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(13, 148, 136, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-grid {
    min-height: 280px;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 32px;
    padding-top: 28px;
    padding-bottom: 28px;
    position: relative;
    z-index: 2;
  }
  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    font-weight: 850;
    color: var(--teal);
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin: 8px 0 10px;
    font-weight: 850;
    color: #ffffff;
    max-width: 640px;
  }
  .hero p {
    font-size: 0.94rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    max-width: 540px;
    margin: 0 0 16px;
  }
  .hero-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    align-items: center;
  }
  .hero-cta-btn {
    padding: 9px 20px;
    font-size: 0.88rem;
    font-weight: 800;
  }
  .cta-arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.15s ease;
  }
  .hero-cta-btn:hover .cta-arrow {
    transform: translateX(3px);
  }
  .secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 9px 18px;
    font-size: 0.85rem;
  }
  .secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .trust {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.76rem;
    font-weight: 600;
    margin-top: 14px;
  }
  .hero-visual {
    display: flex;
    justify-content: flex-end;
  }
  .brand-panel {
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    padding: 20px;
    width: min(100%, 300px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .brand-panel img {
    display: block;
    width: 100%;
    height: 120px;
    object-fit: contain;
  }
  .brand-badge-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--teal-dark);
    background: var(--teal-soft);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--teal-border);
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; min-height: auto; gap: 20px; padding: 22px 0; }
    .hero-visual { display: none; }
  }
  @media (max-width: 680px) {
    .hero-grid { min-height: auto; padding: 14px 0 16px; gap: 10px; }
    .eyebrow { font-size: 0.65rem; }
    .hero h1 { font-size: 1.35rem; margin: 4px 0 6px; line-height: 1.15; }
    .hero p { font-size: 0.82rem; margin-bottom: 10px; line-height: 1.35; }
    .hero-actions { gap: 8px; flex-wrap: wrap; }
    .hero-cta-btn, .secondary { padding: 7px 14px; font-size: 0.78rem; border-radius: var(--radius-pill); }
    .trust { gap: 8px 12px; font-size: 0.7rem; margin-top: 8px; }
    .hero-visual { display: none; }
  }
</style>
