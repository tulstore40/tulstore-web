---
import ProductCard from '../ProductCard.astro';
import type { Product } from '../../lib/catalog';
const { title, subtitle, seeAllHref, products, alt } = Astro.props as {
  title: string;
  subtitle?: string;
  seeAllHref?: string;
  products: Product[];
  alt?: boolean;
};
---
<section class:list={['section', { alt }]}>
  <div class="container">
    <div class="section-head">
      <div><h2>{title}</h2>{subtitle && <p>{subtitle}</p>}</div>
      {seeAllHref && <a class="text-link" href={seeAllHref}>Todos los productos →</a>}
    </div>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>
<style>.alt{background:#eef0f4}</style>
