---
import type { CtaConfig } from '../../lib/siteConfig';
const { data } = Astro.props as { data: CtaConfig };
---
<section class="container cta">
  <div>
    <span class="eyebrow">{data.eyebrow}</span>
    <h2>{data.title}</h2>
    <p>{data.text}</p>
  </div>
  <a class="btn btn-wa" href={data.whatsappHref} target="_blank" rel="noopener">{data.buttonLabel}</a>
</section>
<style>
.cta{margin-top:20px;margin-bottom:70px;background:linear-gradient(135deg,#fff8e8,#fff);border:1px solid #f7dfaa;border-radius:24px;padding:30px 34px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.cta .eyebrow{font-size:.76rem;letter-spacing:.13em;font-weight:900;color:var(--coral-dark)}
.cta h2{font-size:2rem;color:var(--navy);margin:8px 0}
.cta p{color:var(--ink-soft);margin:0}
@media(max-width:680px){.cta{margin-bottom:40px;padding:24px;flex-direction:column;align-items:flex-start}.cta h2{font-size:1.55rem}}
</style>
