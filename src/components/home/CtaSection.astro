---
import type { CtaConfig } from '../../lib/siteConfig';
const { data } = Astro.props as { data: CtaConfig };
---
<section class="container cta">
  <div>
    <span class="eyebrow">{data.eyebrow}</span>
    <h2>{data.title}</h2>
    <p>{data.text}</p>
  </div>
  <a class="btn btn-wa" href={data.whatsappHref} target="_blank" rel="noopener">{data.buttonLabel}</a>
</section>
<style>
.cta{margin-top:12px;margin-bottom:48px;background:linear-gradient(135deg,var(--teal-soft),#fff);border:1px solid #c7eceb;border-radius:20px;padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:26px}
.cta .eyebrow{font-size:.74rem;letter-spacing:.13em;font-weight:900;color:var(--teal-dark)}
.cta h2{font-size:1.75rem;color:var(--navy);margin:6px 0}
.cta p{color:var(--ink-soft);margin:0}
@media(max-width:680px){.cta{margin-bottom:30px;padding:20px;flex-direction:column;align-items:flex-start}.cta h2{font-size:1.4rem}}
</style>
