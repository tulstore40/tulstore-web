---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/CatalogGrid.astro';
import { getProducts, getCategories } from '../lib/catalog';
import { getSiteConfig } from '../lib/siteConfig';
const config = await getSiteConfig();
const products = await getProducts();
const categories = await getCategories(products);
---
<BaseLayout title="Productos | Tulstore" description="Explora el catálogo actualizado de productos Tulstore por categoría, nombre o referencia.">
  <div class="container catalog-header-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><span>Productos</span></div>
    <div class="page-head">
      <div>
        <span class="badge">CATÁLOGO</span>
        <h1>Todos los productos</h1>
        <p>Productos disponibles actualmente en Tulstore.</p>
      </div>
      <span class="count">{products.length} productos</span>
    </div>
  </div>
  <CatalogGrid products={products} categories={categories} config={config.catalog} />
</BaseLayout>

<style>
  .catalog-header-shell {
    padding-top: 4px;
  }
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin: 16px 0 12px;
  }
  .page-head h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    letter-spacing: -0.035em;
    color: var(--navy);
    margin: 6px 0 2px;
    font-weight: 850;
  }
  .page-head p {
    color: var(--ink-soft);
    margin: 0;
    font-size: 0.88rem;
  }
  .count {
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 680px) {
    .catalog-header-shell {
      padding-top: 0;
    }
    .page-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
      margin: 8px 0 8px;
    }
    .page-head h1 {
      font-size: 1.35rem;
      margin: 4px 0 0;
    }
    .page-head p {
      display: none;
    }
    .count {
      display: none;
    }
  }
</style>
