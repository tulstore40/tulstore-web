---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/CatalogGrid.astro';
import { getProducts, getCategories } from '../lib/catalog';
import { getSiteConfig } from '../lib/siteConfig';
const config = await getSiteConfig();
const products = await getProducts();
const categories = await getCategories(products);
---
<BaseLayout title="Productos | Tulstore" description="Explora el catálogo actualizado de productos Tulstore por categoría, nombre o referencia.">
  <div class="container page-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><span>Productos</span></div>
    <div class="page-head"><div><span class="badge">CATÁLOGO</span><h1>Todos los productos</h1><p>Productos disponibles actualmente en Tulstore.</p></div><span class="count">{products.length} productos</span></div>
  </div>
  <CatalogGrid products={products} categories={categories} config={config.catalog} />
</BaseLayout>
<style>.page-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:26px 0}.page-head h1{font-size:clamp(2rem,5vw,3.6rem);letter-spacing:-.04em;color:var(--navy);margin:9px 0}.page-head p{color:var(--ink-soft);margin:0}.count{color:var(--ink-soft);font-size:.86rem}@media(max-width:680px){.page-head{align-items:start;flex-direction:column}.page-head h1{font-size:2.2rem}}</style>
