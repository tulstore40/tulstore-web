---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogGrid from '../../components/CatalogGrid.astro';
import { getProducts, getCategories } from '../../lib/catalog';
import { getSiteConfig } from '../../lib/siteConfig';
const slug = Astro.params.slug || '';
const config = await getSiteConfig();
const products = await getProducts();
const categories = await getCategories(products);
const category = categories.find((item) => item.slug === slug);
if (!category) return Astro.redirect('/productos', 302);
const items = products.filter((p) => p.categoriaSlug === category.slug);
---
<BaseLayout title={`${category.name} | Tulstore`} description={`Explora productos de ${category.name} disponibles en Tulstore.`} canonicalPath={`/categoria/${category.slug}`}>
  <div class="container cat-header-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><a href="/productos">Productos</a><span>›</span><span>{category.name}</span></div>
    <div class="head">
      <span class="badge">CATEGORÍA</span>
      <h1>{category.name}</h1>
      <p>{items.length} productos disponibles.</p>
    </div>
  </div>
  <CatalogGrid products={items} config={config.catalog} categoryFilter={false} />
</BaseLayout>
<style>
  .cat-header-shell { padding-top: 4px; }
  .head { margin: 14px 0 10px; }
  .head h1 { font-size: clamp(1.6rem, 4vw, 2.8rem); letter-spacing: -.035em; color: var(--navy); margin: 6px 0 2px; font-weight: 850; }
  .head p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; }
  @media (max-width: 680px) {
    .cat-header-shell { padding-top: 0; }
    .head { margin: 8px 0 6px; }
    .head h1 { font-size: 1.35rem; }
    .head p { font-size: 0.8rem; }
  }
</style>
