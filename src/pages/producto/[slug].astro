---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, getProducts } from '../../lib/catalog';
import { formatCOP } from '../../lib/format';
const slug = Astro.params.slug || '';
const product = await getProductBySlug(slug);
if (!product) return Astro.redirect('/productos', 302);
const all = await getProducts();
const related = all.filter(p=>p.categoriaSlug===product.categoriaSlug && p.tulstoreId!==product.tulstoreId).slice(0,4);
const jsonLd={"@context":"https://schema.org","@type":"Product",name:product.nombre,image:[product.imagen],description:product.descripcion,sku:product.referencia,offers:{"@type":"Offer",priceCurrency:"COP",price:product.precio,availability:"https://schema.org/InStock",url:new URL(`/producto/${product.slug}`,Astro.site??Astro.url.origin).toString()}};
---
<BaseLayout title={`${product.nombre} | Tulstore`} description={product.descripcion || `Compra ${product.nombre} en Tulstore.`} image={product.imagen} canonicalPath={`/producto/${product.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <div class="container page-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><a href={`/categoria/${product.categoriaSlug}`}>{product.categoria}</a><span>›</span><span>{product.nombre}</span></div>
    <section class="product-detail">
      <div class="photo"><img src={product.imagen} alt={product.nombre} /><span class="badge">Disponible</span></div>
      <div class="info"><span class="category">{product.categoria}</span><h1>{product.nombre}</h1><div class="price">{formatCOP(product.precio)}</div><p class="description">{product.descripcion}</p><dl><div><dt>Referencia</dt><dd>{product.referencia || '—'}</dd></div>{product.color && <div><dt>Color</dt><dd>{product.color}</dd></div>}<div><dt>ID Tulstore</dt><dd>{product.tulstoreId}</dd></div></dl><button class="btn btn-primary main-add" data-add-cart data-product={JSON.stringify({id: product.tulstoreId, slug: product.slug, name: product.nombre, price: product.precio, image: product.imagen, ref: product.referencia})}>Agregar al carrito</button><a class="btn btn-wa direct" href={`https://wa.me/573182022859?text=${encodeURIComponent(`Hola Tulstore, quiero comprar ${product.nombre} (${product.referencia}) por ${formatCOP(product.precio)}.`)}`} target="_blank" rel="noopener">Comprar directo por WhatsApp</a><p class="note">La disponibilidad final se confirma al momento de hacer el pedido.</p></div>
    </section>
    {related.length>0 && <section class="section related"><div class="section-head"><div><h2>También te puede interesar</h2></div></div><div class="product-grid">{related.map(p=><ProductCard product={p}/>)}</div></section>}
  </div>
</BaseLayout>
<style>.product-detail{display:grid;grid-template-columns:1.05fr .95fr;gap:42px;background:white;border-radius:24px;padding:30px;border:1px solid var(--line);box-shadow:var(--shadow)}.photo{position:relative;min-height:500px;display:grid;place-items:center;background:#fbfbfc;border-radius:18px;overflow:hidden}.photo img{width:100%;height:100%;max-height:560px;object-fit:contain;padding:26px}.photo .badge{position:absolute;left:16px;top:16px;background:#dcfce7;color:#166534}.info{padding:18px 10px}.category{font-size:.8rem;font-weight:800;color:var(--teal)}.info h1{font-size:clamp(2rem,4vw,3.4rem);letter-spacing:-.045em;line-height:1.06;color:var(--navy);margin:10px 0 12px}.price{font-size:2rem;font-weight:900;color:var(--coral-dark);margin-bottom:20px}.description{font-size:1.03rem;line-height:1.75;color:#414956}.info dl{margin:25px 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info dl div{background:var(--paper);border-radius:12px;padding:11px 13px}.info dt{font-size:.69rem;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-soft);font-weight:800}.info dd{margin:3px 0 0;font-weight:750}.main-add,.direct{width:100%;margin-top:8px;padding:14px}.note{text-align:center;color:var(--ink-soft);font-size:.76rem}.related{padding-bottom:0}@media(max-width:820px){.product-detail{grid-template-columns:1fr;padding:16px;gap:10px}.photo{min-height:330px}.photo img{max-height:390px;padding:14px}.info{padding:12px 4px}.info h1{font-size:2rem}.info dl{grid-template-columns:1fr 1fr}}</style>
