---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, getProducts } from '../../lib/catalog';
import { formatCOP } from '../../lib/format';
const slug = Astro.params.slug || '';
const product = await getProductBySlug(slug);
if (!product) return Astro.redirect('/productos', 302);
const all = await getProducts();
const related = all.filter(p=>p.categoriaSlug===product.categoriaSlug && p.tulstoreId!==product.tulstoreId).slice(0,4);
const jsonLd={"@context":"https://schema.org","@type":"Product",name:product.nombre,image:[product.imagen],description:product.descripcion,sku:product.referencia,offers:{"@type":"Offer",priceCurrency:"COP",price:product.precio,availability:"https://schema.org/InStock",url:new URL(`/producto/${product.slug}`,Astro.site??Astro.url.origin).toString()}};
---
<BaseLayout title={`${product.nombre} | Tulstore`} description={product.descripcion || `Compra ${product.nombre} en Tulstore.`} image={product.imagen} canonicalPath={`/producto/${product.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <div class="container page-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><a href={`/categoria/${product.categoriaSlug}`}>{product.categoria}</a><span>›</span><span>{product.nombre}</span></div>
    <section class="product-detail">
      <div class="photo"><img src={product.imagen} alt={product.nombre} onerror="this.onerror=null;this.src='/images/tulstore-logo.png';this.style.objectFit='contain';" /><span class="badge">Disponible</span></div>
      <div class="info">
        <span class="category">{product.categoria}</span>
        <h1>{product.nombre}</h1>
        <div class="price">{formatCOP(product.precio)}</div>
        <p class="description">{product.descripcion}</p>
        <dl>
          <div><dt>Referencia</dt><dd>{product.referencia || '—'}</dd></div>
          {product.color && <div><dt>Color</dt><dd>{product.color}</dd></div>}
          <div><dt>ID Tulstore</dt><dd>{product.tulstoreId}</dd></div>
        </dl>
        <button
          type="button"
          class="btn btn-primary main-add"
          data-add-cart
          data-product={JSON.stringify({
            id: product.tulstoreId,
            slug: product.slug,
            name: product.nombre,
            price: product.precio,
            image: product.imagen,
            ref: product.referencia
          })}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="btn-text">Agregar al carrito</span>
        </button>
        <a
          class="btn btn-wa direct"
          href={`https://wa.me/573182022859?text=${encodeURIComponent(`Hola Tulstore, quiero consultar por este producto:\n\n• ${product.nombre} (Ref: ${product.referencia || product.tulstoreId})\nPrecio: ${formatCOP(product.precio)}\nLink: ${new URL(`/producto/${product.slug}`, Astro.site ?? Astro.url.origin).toString()}`)}`}
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" class="btn-icon">
            <path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z"/>
          </svg>
          <span>Consultar por WhatsApp</span>
        </a>
        <p class="note">Disponibilidad sujeta a confirmación inmediata al armar tu pedido.</p>
      </div>
    </section>
    {related.length>0 && <section class="section related"><div class="section-head"><div><h2>También te puede interesar</h2></div></div><div class="product-grid">{related.map(p=><ProductCard product={p}/>)}</div></section>}
  </div>
</BaseLayout>

<style>
  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    background: #ffffff;
    border-radius: var(--radius-card);
    padding: 36px;
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-sm);
    margin-top: 14px;
  }
  .photo {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fbfbfc;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border-soft);
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    max-height: 500px;
    object-fit: contain;
    padding: 24px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .photo:hover img {
    transform: scale(1.03);
  }
  .photo .badge {
    position: absolute;
    left: 18px;
    top: 18px;
    background: #dcfce7;
    color: #166534;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.03em;
  }
  .info {
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .category {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
  }
  .info h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--navy);
    margin: 8px 0 14px;
    font-weight: 900;
  }
  .price {
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--navy);
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .description {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 20px;
  }
  .info dl {
    margin: 10px 0 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .info dl div {
    background: var(--paper);
    border-radius: var(--radius-inner);
    padding: 12px 14px;
    border: 1px solid var(--border-soft);
  }
  .info dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    font-weight: 800;
    margin-bottom: 4px;
  }
  .info dd {
    margin: 0;
    font-weight: 800;
    color: var(--navy);
    font-size: 0.95rem;
  }
  .main-add, .direct {
    width: 100%;
    margin-top: 10px;
    padding: 13px 20px;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }
  .btn-icon {
    width: 19px;
    height: 19px;
  }
  .btn-wa {
    background: #25d366;
    color: #ffffff;
    border: 1px solid #20b858;
  }
  .btn-wa:hover {
    background: #1faa52;
    color: #ffffff;
  }
  .main-add.added {
    background: #059669;
    border-color: #059669;
  }
  .note {
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin-top: 14px;
  }
  .related {
    padding-bottom: 0;
    margin-top: 40px;
  }
  @media (max-width: 820px) {
    .product-detail {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 20px;
    }
    .photo {
      min-height: 300px;
    }
    .photo img {
      max-height: 360px;
      padding: 16px;
    }
    .info {
      padding: 4px;
    }
    .info h1 {
      font-size: 1.8rem;
    }
    .price {
      font-size: 1.8rem;
    }
    .info dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
