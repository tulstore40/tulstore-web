---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategorySection from '../components/home/CategorySection.astro';
import ProductStripSection from '../components/home/ProductStripSection.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getProducts, getCategories } from '../lib/catalog';
import { getSiteConfig, resolveFeatured } from '../lib/siteConfig';

const config = await getSiteConfig();
const products = await getProducts();
const categories = await getCategories(products);

// Alternate the background on consecutive product strips (first strip = alt).
let stripIndex = 0;
---
<BaseLayout>
  {config.home.sections.map((section) => {
    switch (section.type) {
      case 'hero':
        return <HeroSection data={section.data} />;
      case 'categories':
        return <CategorySection data={section.data} categories={categories} />;
      case 'product-strip': {
        const alt = stripIndex % 2 === 0;
        stripIndex += 1;
        return (
          <ProductStripSection
            title={section.data.title}
            subtitle={section.data.subtitle}
            seeAllHref={section.data.seeAllHref}
            products={resolveFeatured(products, section.data.rule)}
            alt={alt}
          />
        );
      }
      case 'cta':
        return <CtaSection data={section.data} />;
    }
  })}
</BaseLayout>
