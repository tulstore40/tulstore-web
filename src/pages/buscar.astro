---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/CatalogGrid.astro';
import { getProducts, getCategories } from '../lib/catalog';
import { getSiteConfig } from '../lib/siteConfig';
const q = (Astro.url.searchParams.get('q') || '').trim();
const normalized = q.toLocaleLowerCase('es');
const products = await getProducts();
const results = !normalized ? [] : products.filter((p) => `${p.nombre} ${p.referencia} ${p.color} ${p.categoria}`.toLocaleLowerCase('es').includes(normalized));
const config = await getSiteConfig();
const categories = q && results.length > 0 ? await getCategories(products) : [];
---
<BaseLayout title={q ? `${q} | Buscar en Tulstore` : 'Buscar productos | Tulstore'} description="Busca productos, referencias y categorías en Tulstore.">
  <div class="container search-header-shell">
    <div class="breadcrumbs"><a href="/">Inicio</a><span>›</span><span>Buscar</span></div>
    <div class="head">
      <span class="badge">BUSCADOR</span>
      <h1>{q ? `Resultados para “${q}”` : 'Busca en Tulstore'}</h1>
      <p>{q ? `${results.length} producto${results.length===1?'':'s'} encontrado${results.length===1?'':'s'}.` : 'Escribe en el buscador para encontrar productos.'}</p>
    </div>
    {q && results.length===0 && <div class="empty-state">No encontramos productos con esa búsqueda.</div>}
  </div>
  {q && results.length > 0 && <CatalogGrid products={results} categories={categories} config={config.catalog} />}
</BaseLayout>
<style>
  .search-header-shell { padding-top: 4px; }
  .head { margin: 14px 0 10px; }
  .head h1 { font-size: clamp(1.6rem, 4vw, 2.8rem); letter-spacing: -.035em; color: var(--navy); margin: 6px 0 2px; font-weight: 850; }
  .head p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; }
  @media (max-width: 680px) {
    .search-header-shell { padding-top: 0; }
    .head { margin: 8px 0 6px; }
    .head h1 { font-size: 1.35rem; }
    .head p { font-size: 0.8rem; }
  }
</style>
