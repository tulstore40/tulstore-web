---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; canonicalPath?: string; }
const {
  title = 'Tulstore | Todo lo que necesitas, en un solo lugar',
  description = 'Descubre productos para hogar, cocina, tecnología, bienestar y mucho más. Compra fácil por WhatsApp en Tulstore.',
  image = '/images/tulstore-logo.png',
  canonicalPath = Astro.url.pathname
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#172542" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Tulstore" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/images/tulstore-logo.png" />
</head>
<body>
  <Header />
  <main><slot /></main>
  <footer class="footer">
    <div class="container foot-grid">
      <div class="foot-brand">
        <img src="/images/tulstore-logo.png" alt="Tulstore" />
        <p>Todo lo que necesitas, en un solo lugar.</p>
        <div class="socials">
          <a href="https://www.instagram.com/tulstore_?stkn=MWFoNm1ydWZ5MDVzMQ==" target="_blank" rel="noopener" aria-label="Instagram de Tulstore">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.4"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.tiktok.com/@tulstore6?_r=1&_t=ZS-9AE3WCBkWkm" target="_blank" rel="noopener" aria-label="TikTok de Tulstore">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3.2c.3 2.3 1.7 3.9 4 4.2v2.8c-1.4.1-2.8-.3-4-1.1v5.9c0 3-2.4 5.1-5.2 4.9-2.5-.2-4.4-2.3-4.3-4.8.1-2.5 2.3-4.5 4.8-4.3.3 0 .6.1.9.1v2.9c-.3-.1-.6-.2-.9-.2-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2V3.2H14z" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://wa.me/573182022859" target="_blank" rel="noopener" aria-label="WhatsApp de Tulstore">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>
      <div><strong>Comprar</strong><a href="/productos">Todos los productos</a><a href="/buscar">Buscar</a></div>
      <div><strong>Atención</strong><a href="https://wa.me/573182022859" target="_blank" rel="noopener">WhatsApp</a><span>Colombia</span></div>
    </div>
    <div class="container copy">© {new Date().getFullYear()} Tulstore. Todos los derechos reservados.</div>
  </footer>
  <a class="wa-float" href="https://wa.me/573182022859" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3a9.6 9.6 0 0 0-8.2 14.5L2.3 21.7l4.9-1.3A9.6 9.6 0 1 0 12 2.3zm0 1.8a7.8 7.8 0 0 1 6.6 12 7.8 7.8 0 0 1-9.8 2.4l-.4-.2-2.9.8.8-2.8-.2-.4A7.8 7.8 0 0 1 12 4.1zm-2.9 3.6c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.2.2-.3.2-.5l.1-.4c0-.2 0-.3-.1-.4l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.1z" fill="currentColor" stroke="none"/></svg>
  </a>
  <CartDrawer />
  <div class="cart-toast" data-cart-toast role="status" aria-live="polite" hidden>
    <div class="toast-left">
      <div class="toast-check">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </div>
      <span class="toast-msg">Agregado al carrito</span>
    </div>
    <button type="button" class="toast-btn-view" data-cart-open>Ver carrito →</button>
  </div>

  <script>
    interface CartItem { id: string | number; name: string; ref: string; price: number; image: string; qty: number; }
    const money = (value: number) => new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(value);
    const KEY = 'tulstore_cart_v1';
    const getCart = (): CartItem[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const setCart = (cart: CartItem[]) => { localStorage.setItem(KEY, JSON.stringify(cart)); renderCart(); };
    
    function renderCart(){
      const cart = getCart();
      const count = cart.reduce((n: number, i: CartItem)=>n+i.qty,0);
      document.querySelectorAll('[data-cart-count]').forEach(el=>el.textContent=String(count));
      document.querySelectorAll('[data-drawer-count-badge]').forEach(el=>el.textContent=String(count));
      const box = document.querySelector('[data-cart-items]');
      const total = cart.reduce((s: number, i: CartItem)=>s+i.price*i.qty,0);
      const totalEl = document.querySelector('[data-cart-total]');
      if(totalEl) totalEl.textContent = money(total);
      const checkout = document.querySelector<HTMLButtonElement>('[data-cart-checkout]');
      if(checkout) checkout.disabled = !cart.length;
      if(!box) return;
      if(!cart.length){
        box.innerHTML = `
          <div class="empty-cart-state">
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </div>
            <p class="empty-title">Tu carrito está vacío</p>
            <p class="empty-desc">Explora el catálogo y agrega tus productos favoritos para armar tu pedido.</p>
            <button type="button" class="btn btn-primary btn-empty-browse" data-cart-close>
              Explorar productos
            </button>
          </div>
        `;
        return;
      }
      box.innerHTML = cart.map((i: CartItem, index: number)=>`
        <div class="cart-item">
          <div class="cart-item-img">
            <img src="${i.image}" alt="${i.name}" onerror="this.onerror=null;this.src='/images/tulstore-logo.png';">
          </div>
          <div class="cart-item-info">
            <strong>${i.name}</strong>
            <small>${i.ref || 'Tulstore'}</small>
            <span class="item-unit-price">${money(i.price)}</span>
            <div class="qty-control">
              <button type="button" data-cart-minus="${index}" aria-label="Disminuir cantidad">−</button>
              <span>${i.qty}</span>
              <button type="button" data-cart-plus="${index}" aria-label="Aumentar cantidad">+</button>
            </div>
          </div>
          <button type="button" class="cart-item-remove" data-cart-remove="${index}" aria-label="Eliminar ${i.name}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            </svg>
          </button>
        </div>
      `).join('');
    }

    function openCart(){
      document.querySelector('[data-cart-drawer]')?.classList.add('open');
      document.querySelector('[data-cart-overlay]')?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeCart(){
      document.querySelector('[data-cart-drawer]')?.classList.remove('open');
      document.querySelector('[data-cart-overlay]')?.classList.remove('open');
      document.body.style.overflow = '';
    }

    let toastTimer = 0;
    const showToast = () => {
      const toast = document.querySelector<HTMLElement>('[data-cart-toast]');
      if(!toast) return;
      toast.hidden = false;
      toast.style.display = 'flex';
      void toast.offsetWidth;
      toast.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(()=>{
        toast.classList.remove('show');
        window.setTimeout(()=>{
          toast.hidden = true;
          toast.style.display = 'none';
        }, 250);
      }, 2600);
    };

    document.addEventListener('click',(e)=>{
      const el = e.target instanceof Element ? e.target : null;
      if(!el) return;
      const add = el.closest('[data-add-cart]');
      if(add){
        const raw = add.getAttribute('data-product');
        if(!raw) return;
        try {
          const product = JSON.parse(raw) as Omit<CartItem,'qty'>;
          const cart = getCart();
          const found = cart.find((i: CartItem)=>String(i.id)===String(product.id));
          found ? found.qty++ : cart.push({...product, qty: 1});
          setCart(cart);

          // Micro-interaction on card button
          const btnText = add.querySelector('.btn-text');
          if(btnText){
            const oldText = btnText.textContent;
            btnText.textContent = '¡Agregado! ✓';
            add.classList.add('added');
            window.setTimeout(()=>{
              btnText.textContent = oldText;
              add.classList.remove('added');
            }, 1400);
          }

          showToast();
        } catch (err) {
          console.error('Error adding to cart:', err);
        }
        return;
      }
      if(el.closest('[data-cart-open]')) return openCart();
      if(el.closest('[data-cart-close]') || el.closest('[data-cart-overlay]')) return closeCart();
      const plus = el.closest('[data-cart-plus]');
      const minus = el.closest('[data-cart-minus]');
      const rem = el.closest('[data-cart-remove]');
      if(plus || minus || rem){
        const cart = getCart();
        const target = plus || minus || rem;
        if(!target) return;
        const idx = Number(target.getAttribute(plus ? 'data-cart-plus' : minus ? 'data-cart-minus' : 'data-cart-remove'));
        if(rem) {
          cart.splice(idx, 1);
        } else if(plus) {
          cart[idx].qty++;
        } else {
          cart[idx].qty--;
          if(cart[idx].qty <= 0) cart.splice(idx, 1);
        }
        setCart(cart);
      }
    });

    document.addEventListener('keydown', (e) => {
      if(e.key === 'Escape') closeCart();
    });

    // Checkout: Generate WhatsApp message preserving complete order information and item references
    document.querySelector<HTMLButtonElement>('[data-cart-checkout]')?.addEventListener('click', () => {
      const cart = getCart();
      if(!cart.length) return;
      const lines = cart.map((i: CartItem) => `• ${i.qty} x ${i.name} (${i.ref || i.id}) — ${money(i.price * i.qty)}`);
      const total = cart.reduce((s: number, i: CartItem) => s + i.price * i.qty, 0);
      const msg = `Hola Tulstore, quiero hacer este pedido:\n\n${lines.join('\n')}\n\nTotal: ${money(total)}`;
      window.open(`https://wa.me/573182022859?text=${encodeURIComponent(msg)}`, '_blank');
    });

    renderCart();
  </script>
</body>
</html>

<style is:global>
  .footer {
    background: var(--navy);
    color: #ffffff;
    padding: 42px 0 24px;
    margin-top: 48px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .foot-grid > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .foot-grid img {
    width: 130px;
    background: #ffffff;
    border-radius: 12px;
    padding: 6px 10px;
  }
  .foot-grid strong {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .foot-grid p, .foot-grid span {
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
    line-height: 1.5;
    font-size: 0.88rem;
  }
  .foot-grid a {
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    width: fit-content;
    font-size: 0.88rem;
    transition: color 0.15s ease;
  }
  .foot-grid a:hover {
    color: var(--teal);
  }
  .foot-brand {
    max-width: 320px;
  }
  .socials {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  .socials a:hover {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .socials svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .copy {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 28px;
    padding-top: 18px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.8rem;
  }

  .wa-float {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #ffffff;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.15s ease, box-shadow 0.2s ease;
  }
  .wa-float:hover {
    background: var(--whatsapp-dark);
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 10px 26px rgba(37, 211, 102, 0.5);
  }
  .wa-float:active {
    transform: scale(0.96);
  }
  .wa-float svg {
    width: 26px;
    height: 26px;
  }

  /* Interactive, non-intrusive Add-to-cart Toast */
  .cart-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 75;
    transform: translateX(-50%) translateY(20px);
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--navy);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 8px 10px 8px 16px;
    font-size: 0.86rem;
    font-weight: 700;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: calc(100% - 32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cart-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .toast-left {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .toast-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--teal);
    display: grid;
    place-items: center;
    color: #ffffff;
  }
  .toast-check svg {
    width: 14px;
    height: 14px;
  }
  .toast-msg {
    white-space: nowrap;
  }
  .toast-btn-view {
    border: 0;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .toast-btn-view:hover {
    background: var(--teal);
  }

  @media (max-width: 680px) {
    .footer { padding: 30px 0 18px; margin-top: 36px; }
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
    .foot-brand { grid-column: 1 / -1; max-width: none; }
    .wa-float { right: 14px; bottom: 14px; width: 44px; height: 44px; }
    .wa-float svg { width: 24px; height: 24px; }
    .cart-toast { bottom: 16px; padding: 7px 8px 7px 14px; font-size: 0.82rem; }
  }
</style>

